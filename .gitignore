# Runtime data — never commit databases, backups or uploads. The data
# directory is relative to the working one, so a server started below the
# root writes the same files there. Only what the server writes is listed
# (a source directory may be called data); when it starts writing a new
# kind of file under DATA_DIR, add it here and to .dockerignore.
/data/
**/data/backups/
*.db
*.db-*
*.sqlite*
pre-migrate-*.tmp

# Personal fixtures and eval sets (real health data stays out of git)
**/testdata/private/
/private/

# Secrets
.env
.env.*
!.env.example
.npmrc

# Go
/bin/
/dist/
coverage.out
*.test

# Web
node_modules/
/internal/webui/dist/
/web/coverage/
*.tsbuildinfo

# Editors and OS
.idea/
.vscode/
.DS_Store

# The binary `go build ./cmd/tdeemon` writes at the root.
/tdeemon
