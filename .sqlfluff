# sqlfluff for the migrations: `sqlfluff lint` to check, `sqlfluff fix`
# to lay out a new one (never an applied one; see docs/conventions.md).
[sqlfluff]
dialect = sqlite
# Plain SQL: no Jinja, so a literal such as '{#' stays a literal.
templater = raw
max_line_length = 100

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.types]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = upper

# sqlfluff reads CURRENT_TIMESTAMP, CURRENT_DATE, CURRENT_TIME and RAISE
# as functions; written in upper case, as SQLite's documentation does,
# they are left alone.
[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower
ignore_words = current_timestamp,current_date,current_time,raise

# The collations NOCASE, BINARY and RTRIM, and a trigger's NEW and OLD,
# which sqlfluff reads as identifiers.
[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower
ignore_words = nocase,binary,rtrim,new,old
