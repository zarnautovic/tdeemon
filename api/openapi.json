{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "LoginInputBody": {
        "additionalProperties": true,
        "properties": {
          "email": {
            "description": "The address the user signs in with; case does not matter. Required.",
            "type": "string"
          },
          "password": {
            "description": "Required.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ServerInfo": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "Name of the server software.",
            "examples": [
              "tdeemon"
            ],
            "type": "string"
          },
          "version": {
            "description": "Version of the running server; dev when the build carries no version information.",
            "examples": [
              "v0.1.0"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "type": "object"
      },
      "SessionBody": {
        "additionalProperties": false,
        "properties": {
          "expires_at": {
            "description": "When the session ends; then the user signs in again.",
            "format": "date-time",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserBody"
          }
        },
        "required": [
          "user",
          "expires_at"
        ],
        "type": "object"
      },
      "UserBody": {
        "additionalProperties": false,
        "properties": {
          "day_start_hour": {
            "description": "The hour at which the user's day starts; a meal before it belongs to the day before.",
            "format": "int64",
            "maximum": 23,
            "minimum": 0,
            "type": "integer"
          },
          "email": {
            "description": "The address the user signs in with, in lower case.",
            "type": "string"
          },
          "id": {
            "description": "The user's ID.",
            "format": "uuid",
            "type": "string"
          },
          "locale": {
            "description": "The language of the app.",
            "enum": [
              "en",
              "hr"
            ],
            "type": "string"
          },
          "name": {
            "description": "The name the app shows.",
            "type": "string"
          },
          "role": {
            "description": "admin manages the instance and its users.",
            "enum": [
              "admin",
              "user"
            ],
            "type": "string"
          },
          "timezone": {
            "description": "An IANA time zone.",
            "examples": [
              "Europe/Zagreb"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role",
          "locale",
          "timezone",
          "day_start_hour"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "tdeemon API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "description": "Checks the email and password and starts a web session: the response sets the session cookie. A session the request already carries ends. Every failure answers 401 with the same message.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "description": "no-store",
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "schema": {
                  "description": "The session cookie: __Host-tdeemon_session over HTTPS (tdeemon_session over plain HTTP), HttpOnly, SameSite=Lax, for the session's lifetime.",
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Sign in with a password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Ends the request's web session, if any, and clears the cookie. Signing out twice is fine.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "No Content",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "description": "no-store",
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "schema": {
                  "description": "Clears the session cookie.",
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Sign out",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "description": "The signed-in user and when the session ends; 401 without a live session.",
        "operationId": "get-session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "description": "no-store",
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unauthorized"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Get the current session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/info": {
      "get": {
        "description": "Name and version of the running server.",
        "operationId": "get-info",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerInfo"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get server info",
        "tags": [
          "meta"
        ]
      }
    }
  }
}
