{
  "components": {
    "schemas": {
      "CreateTokenInputBody": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "What to call the token.",
            "examples": [
              "iPhone"
            ],
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "scopes": {
            "description": "What it may do: ingest (the phone's health data), tools (log and change through MCP), read.",
            "items": {
              "enum": [
                "ingest",
                "tools",
                "read"
              ],
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 1,
            "type": [
              "array",
              "null"
            ],
            "uniqueItems": true
          }
        },
        "required": [
          "name",
          "scopes"
        ],
        "type": "object"
      },
      "CreatedTokenBody": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "The token's handle; revoke it by this.",
            "format": "uuid",
            "type": "string"
          },
          "last_used_at": {
            "description": "When it was last used, to the hour or so; absent until then.",
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "description": "What the user calls the token.",
            "type": "string"
          },
          "scopes": {
            "description": "What the token may do.",
            "items": {
              "enum": [
                "ingest",
                "tools",
                "read"
              ],
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "token": {
            "description": "The token itself. It is shown only now; tdeemon keeps only its hash.",
            "examples": [
              "tdm_…"
            ],
            "type": "string"
          }
        },
        "required": [
          "token",
          "id",
          "name",
          "scopes",
          "created_at"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "IngestBody": {
        "additionalProperties": false,
        "properties": {
          "days": {
            "items": {
              "$ref": "#/components/schemas/IngestDay"
            },
            "type": "array"
          },
          "ignored": {
            "description": "Metric names tdeemon does not read.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "rejected": {
            "description": "Values out of their bounds, left out; the others are stored.",
            "items": {
              "$ref": "#/components/schemas/IngestRejected"
            },
            "type": "array"
          }
        },
        "required": [
          "days",
          "rejected",
          "ignored"
        ],
        "type": "object"
      },
      "IngestChange": {
        "additionalProperties": false,
        "properties": {
          "before": {
            "description": "The day's value before, of an import; absent when the day had none.",
            "format": "double",
            "type": "number"
          },
          "metric": {
            "type": "string"
          },
          "value": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "metric",
          "value"
        ],
        "type": "object"
      },
      "IngestDay": {
        "additionalProperties": false,
        "properties": {
          "changed": {
            "description": "The values the day keeps now; a value the day held already, or one a manual value or the day's first weighing keeps out, is not here.",
            "items": {
              "$ref": "#/components/schemas/IngestChange"
            },
            "type": "array"
          },
          "date": {
            "format": "date",
            "type": "string"
          }
        },
        "required": [
          "date",
          "changed"
        ],
        "type": "object"
      },
      "IngestMetricsInputBody": {
        "additionalProperties": false,
        "properties": {
          "date": {
            "description": "The day the values belong to.",
            "examples": [
              "2026-10-21"
            ],
            "format": "date",
            "type": "string"
          },
          "metrics": {
            "additionalProperties": {
              "format": "double",
              "type": "number"
            },
            "description": "Values by metric name (docs: DESIGN.md §4): weight (kg), body_fat (%), lean_mass (kg), steps, active_kcal, basal_kcal, sleep_h (hours), rhr (bpm), hrv (ms), vo2max, exercise_min.",
            "type": "object"
          }
        },
        "required": [
          "date",
          "metrics"
        ],
        "type": "object"
      },
      "IngestRejected": {
        "additionalProperties": false,
        "properties": {
          "date": {
            "description": "Absent when the date itself did not read, or the whole metric was left out.",
            "format": "date",
            "type": "string"
          },
          "metric": {
            "type": "string"
          },
          "raw_date": {
            "description": "The date as the source wrote it, when it did not read.",
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "value": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "metric",
          "value",
          "reason"
        ],
        "type": "object"
      },
      "LimitsBody": {
        "additionalProperties": false,
        "properties": {
          "defaults": {
            "additionalProperties": {
              "format": "double",
              "type": "number"
            },
            "description": "A user's limits at the start.",
            "type": "object"
          },
          "effective": {
            "additionalProperties": {
              "format": "double",
              "type": "number"
            },
            "description": "The limits that hold: for each, the stricter of the user's and the instance's.",
            "type": "object"
          },
          "instance": {
            "additionalProperties": {
              "format": "double",
              "type": "number"
            },
            "description": "The instance's limits: no user's goes past them.",
            "type": "object"
          },
          "limits": {
            "additionalProperties": {
              "format": "double",
              "type": "number"
            },
            "description": "The user's limits, by name (docs/limits.md, \"The names of the limits\").",
            "type": "object"
          },
          "looser_below": {
            "description": "The limits a lower value loosens (floors, the fastest loss, the waits); a higher value loosens the others.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "limits",
          "instance",
          "effective",
          "defaults",
          "looser_below"
        ],
        "type": "object"
      },
      "LoginInputBody": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "description": "The address the user signs in with; case does not matter.",
            "maxLength": 254,
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "MethodsBody": {
        "additionalProperties": false,
        "properties": {
          "oidc": {
            "$ref": "#/components/schemas/OidcMethod",
            "description": "The OpenID Connect provider, when the instance has one."
          },
          "password": {
            "description": "Signing in with an email and a password works.",
            "type": "boolean"
          }
        },
        "required": [
          "password"
        ],
        "type": "object"
      },
      "OidcMethod": {
        "additionalProperties": false,
        "properties": {
          "login_url": {
            "description": "Open it in the browser (add ?return_to=/a/path) to sign in through the provider.",
            "examples": [
              "/api/v1/auth/oidc/login"
            ],
            "type": "string"
          },
          "name": {
            "description": "What to call the provider on the sign-in page.",
            "examples": [
              "Authentik"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "login_url"
        ],
        "type": "object"
      },
      "ProfileBody": {
        "additionalProperties": false,
        "properties": {
          "birth_date": {
            "examples": [
              "1990-06-15"
            ],
            "format": "date",
            "type": "string"
          },
          "height_cm": {
            "description": "The height in centimetres.",
            "format": "double",
            "maximum": 275,
            "minimum": 50,
            "type": "number"
          },
          "missing": {
            "description": "What a plan still needs: sex, birth_date, height_cm. A plan needs the whole profile; logging needs none of it.",
            "items": {
              "enum": [
                "sex",
                "birth_date",
                "height_cm"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "sex": {
            "description": "The sex the energy equations take.",
            "enum": [
              "male",
              "female"
            ],
            "type": "string"
          }
        },
        "required": [
          "missing"
        ],
        "type": "object"
      },
      "ProfileFields": {
        "additionalProperties": false,
        "properties": {
          "birth_date": {
            "examples": [
              "1990-06-15"
            ],
            "format": "date",
            "type": "string"
          },
          "height_cm": {
            "description": "The height in centimetres.",
            "format": "double",
            "maximum": 275,
            "minimum": 50,
            "type": "number"
          },
          "sex": {
            "description": "The sex the energy equations take.",
            "enum": [
              "male",
              "female"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "ServerInfo": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "Name of the server software.",
            "examples": [
              "tdeemon"
            ],
            "type": "string"
          },
          "version": {
            "description": "Version of the running server; dev when the build carries no version information.",
            "examples": [
              "v0.1.0"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "type": "object"
      },
      "SessionBody": {
        "additionalProperties": false,
        "properties": {
          "expires_at": {
            "description": "When the session ends; then the user signs in again.",
            "format": "date-time",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserBody"
          }
        },
        "required": [
          "user",
          "expires_at"
        ],
        "type": "object"
      },
      "SetLimitsInputBody": {
        "additionalProperties": false,
        "properties": {
          "confirm": {
            "description": "Loosening a limit takes this: the user saw that the change allows a plan the limit refused.",
            "type": "boolean"
          },
          "limits": {
            "additionalProperties": {
              "format": "double",
              "type": "number"
            },
            "description": "The limits to change, by name; those not named stay as they are.",
            "type": "object"
          }
        },
        "required": [
          "limits"
        ],
        "type": "object"
      },
      "TokenBody": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "The token's handle; revoke it by this.",
            "format": "uuid",
            "type": "string"
          },
          "last_used_at": {
            "description": "When it was last used, to the hour or so; absent until then.",
            "format": "date-time",
            "type": "string"
          },
          "name": {
            "description": "What the user calls the token.",
            "type": "string"
          },
          "scopes": {
            "description": "What the token may do.",
            "items": {
              "enum": [
                "ingest",
                "tools",
                "read"
              ],
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "scopes",
          "created_at"
        ],
        "type": "object"
      },
      "TokensOutputBody": {
        "additionalProperties": false,
        "properties": {
          "tokens": {
            "items": {
              "$ref": "#/components/schemas/TokenBody"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "tokens"
        ],
        "type": "object"
      },
      "UserBody": {
        "additionalProperties": false,
        "properties": {
          "day_start_hour": {
            "description": "The hour at which the user's day starts; a meal before it belongs to the day before.",
            "format": "int64",
            "maximum": 23,
            "minimum": 0,
            "type": "integer"
          },
          "email": {
            "description": "The address the user signs in with, in lower case.",
            "type": "string"
          },
          "id": {
            "description": "The user's ID.",
            "format": "uuid",
            "type": "string"
          },
          "locale": {
            "description": "The language of the app.",
            "enum": [
              "en",
              "hr"
            ],
            "type": "string"
          },
          "name": {
            "description": "The name the app shows.",
            "type": "string"
          },
          "role": {
            "description": "admin manages the instance and its users.",
            "enum": [
              "admin",
              "user"
            ],
            "type": "string"
          },
          "timezone": {
            "description": "An IANA time zone.",
            "examples": [
              "Europe/Zagreb"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role",
          "locale",
          "timezone",
          "day_start_hour"
        ],
        "type": "object"
      },
      "WhoamiOutputBody": {
        "additionalProperties": false,
        "properties": {
          "scopes": {
            "description": "What the token may do (via token).",
            "items": {
              "enum": [
                "ingest",
                "tools",
                "read"
              ],
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "user": {
            "$ref": "#/components/schemas/UserBody"
          },
          "via": {
            "description": "How the request authenticated.",
            "enum": [
              "session",
              "token"
            ],
            "type": "string"
          }
        },
        "required": [
          "user",
          "via"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "tdeemon API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "description": "Checks the email and password and starts a web session: the response sets the session cookie. A session the request already carries ends. A wrong address or password answers 401, always with the same message; a body that breaks the schema answers 400, 413, 415 or 422, and no error detail echoes a value it sent. After 10 failed sign-ins in 15 minutes from one address, or for one account, sign-ins from there or for it answer 429 with Retry-After until the 15 minutes have passed; sign-ins still being checked count too. When too many passwords are being checked at once, a sign-in that waited 10 seconds answers 503 with Retry-After.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "description": "no-store",
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "schema": {
                  "description": "The session cookie: __Host-tdeemon_session over HTTPS (tdeemon_session over plain HTTP), HttpOnly, SameSite=Lax, for the session's lifetime.",
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Sign in with a password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Ends the request's web session, if any, and clears the cookie. Signing out twice is fine.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "No Content",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "description": "no-store",
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "schema": {
                  "description": "Clears the session cookie.",
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Forbidden"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Sign out",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/methods": {
      "get": {
        "description": "What the sign-in page offers: a password, and an OpenID Connect provider when one is configured.",
        "operationId": "get-auth-methods",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MethodsBody"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Forbidden"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Get the ways to sign in",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "description": "The signed-in user and when the session ends; 401 without a live session.",
        "operationId": "get-session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "description": "no-store",
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Forbidden"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Get the current session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/whoami": {
      "get": {
        "description": "The user, and whether the request came with a web session or an API token (with its scopes): a way for a client to check its token. Any token may call it.",
        "operationId": "whoami",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoamiOutputBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "description": "no-store",
                  "type": "string"
                }
              }
            }
          },
          "401": {
