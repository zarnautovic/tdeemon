+// fmt is the numbers and dates of a language, as the app writes them.
+function fmt(lang: Lang) {
+  const n = (x: number, digits = 0) =>
+    new Intl.NumberFormat(lang, { maximumFractionDigits: digits }).format(x)
+  const date = (d: string, o: Intl.DateTimeFormatOptions) =>
+    new Intl.DateTimeFormat(lang, { ...o, timeZone: 'UTC' }).format(new Date(`${d}T00:00:00Z`))
+  return {
+    n,
+    signed: (x: number) =>
+      new Intl.NumberFormat(lang, { maximumFractionDigits: 0, signDisplay: 'exceptZero' }).format(
+        x,
+      ),
+    pct: (x: number) =>
+      new Intl.NumberFormat(lang, {
+        style: 'percent',
+        minimumFractionDigits: 2,
+        maximumFractionDigits: 2,
+      }).format(Math.abs(x) / 100),
+    signedPct: (x: number) =>
+      new Intl.NumberFormat(lang, {
+        style: 'percent',
+        minimumFractionDigits: 2,
+        maximumFractionDigits: 2,
+        signDisplay: 'exceptZero',
+      }).format(x / 100),
+    day: (d: string) => date(d, { weekday: 'short', day: 'numeric', month: 'short' }),
+    long: (d: string) => date(d, { weekday: 'long', day: 'numeric', month: 'long' }),
+  }
+}
