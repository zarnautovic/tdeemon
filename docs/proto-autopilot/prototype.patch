+// PROTOTYPE ONLY (branch proto/autopilot, never merged): the panel that
+// picks the autopilot's state to look at, and the language; hidden with
+// ?shot (the screenshots').
+
+import { useQueryClient } from '@tanstack/react-query'
+import { Link } from '@tanstack/react-router'
+import { useState } from 'react'
+
+import { fetchClient } from '@/api/client'
+import { setLocale, useLocale } from '@/i18n/locale'
+
+import { choose, scenarios, useScenario } from './store'
+
+// Read as the app loads, before the router tidies the address.
+const shot = new URLSearchParams(globalThis.location.search).has('shot')
+function hidden(): boolean {
+  return shot
+}
+
+export function ProtoPanel() {
+  const s = useScenario()
+  const queryClient = useQueryClient()
+  const locale = useLocale()
+  const [open, setOpen] = useState(true)
+  if (hidden()) {
+    return null
+  }
+  return (
+    <div className="fixed right-2 bottom-20 z-50 max-w-[16rem] rounded-lg border bg-card p-2 text-caption shadow-card lg:bottom-4">
+      <button
+        type="button"
+        className="w-full text-left font-semibold"
+        onClick={() => {
+          setOpen(!open)
+        }}
+      >
+        Prototype: autopilot {open ? '▾' : '▸'}
+      </button>
+      {open && (
+        <div className="mt-1 space-y-1">
+          <select
+            aria-label="State"
+            className="w-full rounded border bg-background p-1"
+            value={s.id}
+            onChange={(e) => {
+              choose(e.target.value)
+              void queryClient.invalidateQueries()
+            }}
+          >
+            {scenarios.map((x) => (
+              <option key={x.id} value={x.id}>
+                {x.label}
+              </option>
+            ))}
+          </select>
+          <div className="flex items-center justify-between gap-2">
+            <button
+              type="button"
+              className="underline"
+              onClick={() => {
+                // The account's language, so the server's text (the
+                // morning summary) follows it too.
+                const next = locale === 'en' ? 'hr' : 'en'
+                void (async () => {
+                  await fetchClient.PATCH('/api/v1/me', { body: { locale: next } })
+                  setLocale(next)
+                  await queryClient.invalidateQueries()
+                })()
+              }}
+            >
+              {locale === 'en' ? 'Hrvatski' : 'English'}
+            </button>
+            <Link to="/proto/messages" className="underline">
+              Messages
+            </Link>
+          </div>
+        </div>
+      )}
+    </div>
+  )
+}
diff --git a/web/src/proto/scenarios.ts b/web/src/proto/scenarios.ts
new file mode 100644
index 0000000..4564f64
--- /dev/null
+++ b/web/src/proto/scenarios.ts
@@ -0,0 +1,650 @@
+// PROTOTYPE ONLY (branch proto/autopilot, never merged). The states of
+// the autopilot the prototype shows, made up and built around today, so
+// the last weekly review is this morning's and its line shows on today.
+
+import type { components } from '@/api/schema'
+import { addDays } from '@/i18n/format'
+
+import type { Autopilot, CheckIn, Drift, Weekday } from './types'
+
+type Proposal = components['schemas']['ProposalBody']
+type Phase = components['schemas']['PhaseBody']
+type Target = components['schemas']['TargetPeriodBody']
+type DayTarget = components['schemas']['DayTargetBody']
+type Verdict = components['schemas']['VerdictBody']
+type Tdee = components['schemas']['TdeeBody']
+
+// ApProposal is a proposal as the API would give one the autopilot made:
+// its review's numbers beside the code `autopilot`.
+export type ApProposal = Proposal & { check_in?: CheckIn }
+
+export interface Scenario {
+  id: string
+  label: string
+  autopilot: Autopilot
+  phases: Phase[]
+  targets: Target[]
+  training_weekdays: Weekday[]
+  revisions: ApProposal[]
+  pending?: ApProposal | undefined
+  verdict?: Partial<Verdict>
+  tdee?: Partial<Tdee>
+}
+
+const weekdayNames: Weekday[] = [
+  'sunday',
+  'monday',
+  'tuesday',
+  'wednesday',
+  'thursday',
+  'friday',
+  'saturday',
+]
+
+export function weekdayOf(date: string): Weekday {
+  return weekdayNames[new Date(`${date}T00:00:00Z`).getUTCDay()] ?? 'monday'
+}
+
+const training: Weekday[] = ['monday', 'wednesday', 'friday']
+
+// day is a type of day's target: its protein and fat stay, the carbs fill
+// the kcal (4 kcal a gram), as a step moves only them.
+function day(kcal: number, protein: number, fat: number): DayTarget {
+  return { kcal, protein, fat, carbs: Math.round(((kcal - protein * 4 - fat * 9) / 4) * 10) / 10 }
+}
+
+function values(t: number, r: number, protein = 170, fat: readonly [number, number] = [70, 65]) {
+  return { training: day(t, protein, fat[0]), rest: day(r, protein, fat[1]) }
+}
+
+// avg is the weekly average over three training days.
+function avg(t: number, r: number): number {
+  return Math.round((3 * t + 4 * r) / 7)
+}
+
+let seq = 0
+function id(): string {
+  seq += 1
+  return `00000000-0000-7000-8000-${String(seq).padStart(12, '0')}`
+}
+
+function at(date: string, hour = 6): string {
+  return `${date}T${String(hour - 1).padStart(2, '0')}:30:00Z`
+}
+
+// A cut's review: the verdict's numbers of a slow loss.
+const slowCut = {
+  phase: 'cut',
+  measured_pct_week: -0.31,
+  target_pct_week: -0.5,
+  tolerance_pct_week: 0.1,
+  tdee_kcal: 2600,
+  tdee_half_width: 120,
+  intake_kcal: 2140,
+  logged_days: 6,
+  weigh_ins: 5,
+  needs_logged_days: 4,
+  needs_weigh_ins: 3,
+} as const satisfies Partial<CheckIn>
+
+// steps builds a plan whose target the autopilot stepped: the user's
+// first target on the phase's start, then each step from its day, and
+// the revisions, newest first.
+function stepped(
+  today: string,
+  start: string,
+  base: [number, number],
+  steps: { ago: number; kcal: number; check?: Partial<CheckIn> }[],
+): { targets: Target[]; revisions: ApProposal[] } {
+  const targets: Target[] = [{ effective_from: start, ...values(base[0], base[1]) }]
+  const revisions: ApProposal[] = [
+    {
+      id: id(),
+      by: { client: 'web' },
+      rationale: 'changed in the app',
+      status: 'applied',
+      created_at: at(start, 9),
+      decided_at: at(start, 9),
+      expires_at: at(addDays(start, 7), 9),
+      changes: {
+        phases: [],
+        targets: [{ from: start, after: values(base[0], base[1]) }],
+        limits: [],
+      },
+    },
+  ]
+  let [t, r] = base
+  for (const s of steps) {
+    const from = addDays(today, -s.ago)
+    const before = values(t, r)
+    const prev = avg(t, r)
+    t += s.kcal
+    r += s.kcal
+    targets.push({ effective_from: from, ...values(t, r) })
+    revisions.unshift({
+      id: id(),
+      by: { client: 'autopilot' },
+      rationale: 'autopilot',
+      status: 'applied',
+      created_at: at(from),
+      decided_at: at(from),
+      expires_at: at(addDays(from, 7)),
+      changes: { phases: [], targets: [{ from, before, after: values(t, r) }], limits: [] },
+      check_in: {
+        ...slowCut,
+        date: from,
+        outcome: 'applied',
+        reason: 'cut_slow',
+        step_kcal: s.kcal,
+        target_kcal: prev,
+        after_kcal: avg(t, r),
+        ...s.check,
+      },
+    })
+  }
+  // Each target runs to the day before the next.
+  for (let i = 0; i < targets.length - 1; i++) {
+    const here = targets[i]
+    const next = targets[i + 1]
+    if (here !== undefined && next !== undefined) {
+      targets[i] = { ...here, to: addDays(next.effective_from, -1) }
+    }
+  }
+  return { targets, revisions }
+}
+
+function drift(used: number, base: [number, number], from: string, tdee = 2600): Drift {
+  return {
+    used_kcal: used,
+    limit_kcal: Math.round((tdee * 15) / 100),
+    limit_pct: 15,
+    base_kcal: avg(base[0], base[1]),
+    base_from: from,
+    tdee_kcal: tdee,
+  }
+}
+
+function cut(start: string): Phase {
+  return { type: 'cut', start, rate_pct_week: -0.5, goal_weight: 80 }
+}
+
+const trustedTdee: Partial<Tdee> = { measured: true, trusted: true, kcal: 2600, half_width: 120 }
+
+function verdictOf(c: Partial<CheckIn>): Partial<Verdict> {
+  const rate =
+    c.measured_pct_week === undefined || c.target_pct_week === undefined
+      ? 'none'
+      : Math.abs(c.measured_pct_week - c.target_pct_week) <= (c.tolerance_pct_week ?? 0.1)
+        ? 'on_target'
+        : c.measured_pct_week < c.target_pct_week
+          ? 'below'
+          : 'above'
+  const v: Partial<Verdict> = {
+    rate,
+    action: rate === 'on_target' || rate === 'none' ? 'hold' : 'lower_kcal',
+  }
+  if (c.measured_pct_week !== undefined) v.measured_pct_week = c.measured_pct_week
+  if (c.target_pct_week !== undefined) v.target_pct_week = c.target_pct_week
+  if (c.tolerance_pct_week !== undefined) v.tolerance_pct_week = c.tolerance_pct_week
+  if (c.intake_kcal !== undefined) v.intake_kcal = c.intake_kcal
+  if (c.target_kcal !== undefined) v.target_kcal = c.target_kcal
+  return v
+}
+
+// lastOf is the review of the newest revision, the autopilot's.
+function lastOf(revisions: ApProposal[]): CheckIn {
+  const c = revisions[0]?.check_in
+  if (c === undefined) {
+    throw new Error('no review')
+  }
+  return c
+}
+
+// build makes every state around today.
+export function build(today: string): Scenario[] {
+  seq = 0
+  const start = addDays(today, -35)
+  const weekday = weekdayOf(today)
+  const next = addDays(today, 7)
+  const base: [number, number] = [2450, 2150]
+  const ap = (mode: Autopilot['mode'], used: number, last: CheckIn): Autopilot => ({
+    mode,
+    weekday,
+    next,
+    step_kcal: 100,
+    drift: drift(used, base, start),
+    last,
+  })
+
+  const scenarios: Scenario[] = []
+
+  // 1. Autopilot: a step down applied this morning.
+  {
+    const p = stepped(today, start, base, [
+      { ago: 14, kcal: -100 },
+      { ago: 0, kcal: -100 },
+    ])
+    const last = lastOf(p.revisions)
+    scenarios.push({
+      id: 'auto-step',
+      label: 'Autopilot · step down applied',
+      autopilot: ap('autopilot', -200, last),
+      phases: [cut(start)],
+      training_weekdays: training,
+      ...p,
+      tdee: trustedTdee,
+      verdict: verdictOf(last),
