+
+  // 8. No plan.
+  {
+    const check: CheckIn = { date: today, outcome: 'skipped', reason: 'no_plan' }
+    scenarios.push({
+      id: 'auto-no-plan',
+      label: 'Autopilot · no phase or target',
+      autopilot: { ...ap('autopilot', 0, check), drift: drift(0, base, today) },
+      phases: [],
+      targets: [],
+      training_weekdays: training,
+      revisions: [],
+      tdee: trustedTdee,
+      verdict: { rate: 'none', action: 'none', reasons: ['no_phase'] },
+    })
+  }
+
+  // 9. A coach's proposal waits: the review waits for it.
+  {
+    const p = holdPlan()
+    const check: CheckIn = { ...slowCut, date: today, outcome: 'skipped', reason: 'pending' }
+    const pending: ApProposal = {
+      id: id(),
+      by: { client: 'mcp', model: 'claude-opus-5-5' },
+      rationale:
+        'Your loss has slowed for three weeks while you logged well. I suggest a diet break of two weeks at maintenance, then the cut again.',
+      status: 'pending',
+      created_at: at(addDays(today, -1), 20),
+      expires_at: at(addDays(today, 6), 20),
+      changes: {
+        phases: [
+          {
+            start: addDays(today, 2),
+            after: {
+              type: 'maintain',
+              start: addDays(today, 2),
+              rate_pct_week: 0,
+              end: addDays(today, 15),
+            },
+          },
+        ],
+        targets: [],
+        limits: [],
+      },
+    }
+    scenarios.push({
+      id: 'auto-pending',
+      label: 'Autopilot · waits for a coach’s proposal',
+      autopilot: ap('autopilot', -100, check),
+      phases: [cut(start)],
+      training_weekdays: training,
+      ...p,
+      pending,
+      tdee: trustedTdee,
+      verdict: verdictOf({ ...check, target_kcal: avg(2350, 2050) }),
+    })
+  }
+
+  // 10. Past the drift limit: the step it would apply, proposed.
+  {
+    const p = stepped(today, start, base, [
+      { ago: 21, kcal: -100 },
+      { ago: 14, kcal: -100 },
+      { ago: 7, kcal: -100 },
+    ])
+    const check: CheckIn = {
+      ...slowCut,
+      measured_pct_week: -0.28,
+      date: today,
+      outcome: 'proposed',
+      reason: 'cut_slow',
+      past_drift: true,
+      step_kcal: -100,
+      target_kcal: avg(2150, 1850),
+      after_kcal: avg(2050, 1750),
+    }
+    const pending: ApProposal = {
+      id: id(),
+      by: { client: 'autopilot' },
+      rationale: 'autopilot',
+      status: 'pending',
+      created_at: at(today),
+      expires_at: at(addDays(today, 7)),
+      changes: {
+        phases: [],
+        targets: [{ from: today, before: values(2150, 1850), after: values(2050, 1750) }],
+        limits: [],
+      },
+      check_in: check,
+    }
+    check.proposal_id = pending.id
+    scenarios.push({
+      id: 'auto-drift',
+      label: 'Autopilot · past the drift limit, proposes',
+      autopilot: ap('autopilot', -300, check),
+      phases: [cut(start)],
+      training_weekdays: training,
+      ...p,
+      pending,
+      tdee: trustedTdee,
+      verdict: verdictOf(check),
+    })
+  }
+
+  // 11. Underweight while losing: maintenance proposed, never a step.
+  {
+    const p = stepped(today, start, [2050, 1850], [])
+    const check: CheckIn = {
+      date: today,
+      outcome: 'proposed',
+      reason: 'underweight',
+      bmi: 18.4,
+      phase: 'cut',
+      measured_pct_week: -0.45,
+      target_pct_week: -0.5,
+      tolerance_pct_week: 0.1,
+      tdee_kcal: 2150,
+      tdee_half_width: 110,
+    }
+    const pending: ApProposal = {
+      id: id(),
+      by: { client: 'autopilot' },
+      rationale: 'autopilot',
+      status: 'pending',
+      created_at: at(today),
+      expires_at: at(addDays(today, 7)),
+      changes: {
+        phases: [
+          {
+            start: addDays(today, 1),
+            after: { type: 'maintain', start: addDays(today, 1), rate_pct_week: 0 },
+          },
+        ],
+        targets: [
+          {
+            from: addDays(today, 1),
+            before: values(2050, 1850, 130, [60, 55]),
+            after: values(2300, 2050, 130, [60, 55]),
+          },
+        ],
+        limits: [],
+      },
+      check_in: check,
+    }
+    check.proposal_id = pending.id
+    scenarios.push({
+      id: 'auto-underweight',
+      label: 'Autopilot · underweight, maintenance proposed',
+      autopilot: { ...ap('autopilot', 0, check), drift: drift(0, [2050, 1850], start, 2150) },
+      phases: [cut(start)],
+      training_weekdays: training,
+      ...p,
+      pending,
+      tdee: { ...trustedTdee, kcal: 2150, half_width: 110 },
+      verdict: { ...verdictOf(check), action: 'maintain', guards: ['underweight'] },
+    })
+  }
+
+  // 12. A bulk too slow: a step up applied.
+  {
+    const s = start
+    const p = stepped(
+      today,
+      s,
+      [2900, 2700],
+      [
+        {
+          ago: 0,
+          kcal: 100,
+          check: {
+            phase: 'bulk',
+            reason: 'bulk_slow',
+            measured_pct_week: 0.08,
+            target_pct_week: 0.25,
+            tdee_kcal: 2750,
+            tdee_half_width: 130,
+            intake_kcal: 2790,
+          },
+        },
+      ],
+    )
+    const last = lastOf(p.revisions)
+    scenarios.push({
+      id: 'auto-bulk-up',
+      label: 'Autopilot · bulk too slow, step up',
+      autopilot: { ...ap('autopilot', 100, last), drift: drift(100, [2900, 2700], s, 2750) },
+      phases: [{ type: 'bulk', start: s, rate_pct_week: 0.25 }],
+      training_weekdays: training,
+      ...p,
+      tdee: { ...trustedTdee, kcal: 2750, half_width: 130 },
+      verdict: { ...verdictOf(last), action: 'raise_kcal' },
+    })
+  }
+
+  // 13. Too few carbs left for a step down: ask a coach.
+  {
+    const lowCarb = (from: string): Target => ({
+      effective_from: from,
+      training: day(1900, 200, 80),
+      rest: day(1700, 200, 72),
+    })
+    const check: CheckIn = {
+      ...slowCut,
+      date: today,
+      outcome: 'skipped',
+      reason: 'few_carbs',
+      carbs_g: day(1700, 200, 72).carbs,
+      target_kcal: avg(1900, 1700),
+    }
+    scenarios.push({
+      id: 'auto-few-carbs',
+      label: 'Autopilot · too few carbs, ask a coach',
+      autopilot: ap('autopilot', -100, check),
+      phases: [cut(start)],
+      training_weekdays: training,
+      targets: [lowCarb(start)],
+      revisions: [],
+      tdee: trustedTdee,
+      verdict: verdictOf(check),
+    })
+  }
+
+  // 14. Lean mass lost on a cut: a step up.
+  {
+    const p = stepped(today, start, base, [
+      { ago: 14, kcal: -100 },
+      {
+        ago: 0,
+        kcal: 100,
+        check: { reason: 'lean_loss', measured_pct_week: -0.62, intake_kcal: 2120 },
+      },
+    ])
+    const last = lastOf(p.revisions)
+    scenarios.push({
+      id: 'auto-lean-loss',
+      label: 'Autopilot · lean mass lost, step up',
+      autopilot: ap('autopilot', 0, last),
+      phases: [cut(start)],
+      training_weekdays: training,
+      ...p,
+      tdee: trustedTdee,
+      verdict: { ...verdictOf(last), action: 'raise_protein_or_kcal', guards: ['lean_mass'] },
+    })
+  }
+
+  return scenarios
+}
