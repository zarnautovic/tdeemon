+      phases: [cut(start)],
+      training_weekdays: training,
+      ...p,
+      pending,
+      tdee: trustedTdee,
+      verdict: verdictOf(check),
+    })
+  }
+
+  // 3. Hold: the pace on plan.
+  const holdPlan = () => stepped(today, start, base, [{ ago: 14, kcal: -100 }])
+  {
+    const check: CheckIn = {
+      ...slowCut,
+      date: today,
+      outcome: 'hold',
+      reason: 'on_target',
+      measured_pct_week: -0.47,
+      intake_kcal: 2160,
+      target_kcal: avg(2350, 2050),
+    }
+    scenarios.push({
+      id: 'auto-hold',
+      label: 'Autopilot · hold, pace on plan',
+      autopilot: ap('autopilot', -100, check),
+      phases: [cut(start)],
+      training_weekdays: training,
+      ...holdPlan(),
+      tdee: trustedTdee,
+      verdict: verdictOf(check),
+    })
+  }
+
+  // 4. Hold: fewer steps explain the slower loss.
+  {
+    const check: CheckIn = {
+      ...slowCut,
+      date: today,
+      outcome: 'hold',
+      reason: 'steps_guard',
+      steps_change_pct: -34,
+      target_kcal: avg(2350, 2050),
+    }
+    scenarios.push({
+      id: 'auto-steps',
+      label: 'Autopilot · hold, steps explain it',
+      autopilot: ap('autopilot', -100, check),
+      phases: [cut(start)],
