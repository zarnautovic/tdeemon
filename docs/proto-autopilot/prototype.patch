+#!/usr/bin/env bash
+# PROTOTYPE ONLY (branch proto/autopilot, never merged): runs the app for
+# the autopilot's design. The server over a fresh data directory in
+# .proto/, with a made-up user (ana@example.com, only-for-the-prototype),
+# a profile, five weeks of made-up weigh-ins, a cut and its targets from
+# today and two meals; then the Vite dev server on 127.0.0.1:5199, whose
+# app fakes what the autopilot's API would answer (web/src/proto). Open
+# http://127.0.0.1:5199/plan?ap=auto-step and pick a state in the panel
+# at the bottom right.
+#
+#   scripts/proto-autopilot.sh            # Ctrl+C stops both
+set -euo pipefail
+
+root=$(cd "$(dirname "$0")/.." && pwd)
+dir=$root/.proto
+port=18190
+web=5199
+email=ana@example.com
+password=only-for-the-prototype
+
+mkdir -p "$dir"
+rm -rf "$dir/data"
+(cd "$root" && go build -o "$dir/tdeemon" ./cmd/tdeemon)
+
+export TDEEMON_DATA_DIR=$dir/data
+# The app's origin is Vite's, which forwards /api here: the server takes
+# it as its own, so a sign-in is not cross-origin.
+export TDEEMON_BASE_URL=http://127.0.0.1:$web
+export TDEEMON_LISTEN=127.0.0.1:$port
+export TDEEMON_LOG_LEVEL=warn
+export TDEEMON_BACKUP_KEEP=0
+export TDEEMON_OPEN_FOOD_FACTS_URL=off
+TDEEMON_SECRET_KEY=$(head -c 32 /dev/urandom | base64)
+export TDEEMON_SECRET_KEY
+
+up() {
+  for _ in $(seq 100); do
+    curl -fs -o /dev/null "http://127.0.0.1:$port/healthz" && return
+    sleep 0.1
+  done
+  echo "the server did not start" >&2
+  exit 1
+}
+# The first start makes the database; the user is made with it stopped,
+# as scripts/e2e-server.sh does.
+"$dir/tdeemon" &
+server=$!
+up
+kill $server
+wait $server || true
+printf '%s\n' "$password" |
+  "$dir/tdeemon" user create --email "$email" --name Ana --timezone Europe/Zagreb --password-stdin >/dev/null
+"$dir/tdeemon" &
+server=$!
+trap 'kill $server ${vite:-} 2>/dev/null || true' EXIT
+up
+
+api=http://127.0.0.1:$port/api/v1
+jar=$dir/cookies
+call() { # method path body
+  curl -fsS -b "$jar" -c "$jar" -X "$1" -H 'Content-Type: application/json' -d "$3" "$api$2" >/dev/null
+}
+curl -fsS -c "$jar" -H 'Content-Type: application/json' \
+  -d "{\"email\":\"$email\",\"password\":\"$password\"}" "$api/auth/login" >/dev/null
+call PUT /profile '{"sex":"male","birth_date":"1990-06-15","height_cm":180}'
+# Made-up weigh-ins, a slow loss: 84.6 kg five weeks ago to about 83.9.
+for i in $(seq 35 -1 0); do
+  d=$(date -d "-$i days" +%F)
+  kg=$(awk -v i="$i" 'BEGIN { printf "%.1f", 83.9 + i * 0.02 + (i % 3 - 1) * 0.15 }')
+  call PUT "/days/$d/metrics/weight" "{\"value\":$kg}" || true
+done
+today=$(date +%F)
+call POST /plan/changes "{\"phases\":[{\"start\":\"$today\",\"type\":\"cut\",\"rate_pct_week\":-0.5}],\"targets\":[{\"from\":\"$today\",\"training\":{\"kcal\":2250,\"protein\":170,\"fat\":70},\"rest\":{\"kcal\":1950,\"protein\":170,\"fat\":65}}]}"
+call POST /meals '{"description":"Breakfast","items":[{"name":"Oats with skyr and berries","nutrients":{"kcal":520,"protein":38,"carbs":70,"fat":9}}]}'
+call POST /meals '{"description":"Lunch","items":[{"name":"Chicken with rice","nutrients":{"kcal":640,"protein":45,"carbs":70,"fat":15}}]}'
+
+echo "Prototype: http://127.0.0.1:$web/plan?ap=auto-step  ($email / $password)"
+cd "$root/web"
+TDEEMON_DEV_SERVER=http://127.0.0.1:$port npx vite --port "$web" --strictPort --host 127.0.0.1 &
+vite=$!
+wait $server
diff --git a/web/e2e/proto-shots.ts b/web/e2e/proto-shots.ts
new file mode 100644
index 0000000..6316824
--- /dev/null
+++ b/web/e2e/proto-shots.ts
@@ -0,0 +1,146 @@
+// PROTOTYPE ONLY (branch proto/autopilot, never merged): screenshots of
+// the autopilot's prototype into docs/proto-autopilot/, with
+// scripts/proto-autopilot.sh running. Each shot: a state (?ap), a page,
+// a phone or a desktop, light or dark, English or Croatian.
+//
+//   (cd web && node e2e/proto-shots.ts [filter])
+/* oxlint-disable eslint/no-await-in-loop -- one shot after another, in one page, by design */
+import { mkdirSync } from 'node:fs'
+import { chromium, devices, type Page } from '@playwright/test'
+
+const base = 'http://127.0.0.1:5199'
+const out = new URL('../../docs/proto-autopilot/', import.meta.url).pathname
+mkdirSync(out, { recursive: true })
+const filter = process.argv[2] ?? ''
+
+type Action = 'history' | 'turn-on' | 'you' | 'morning' | null
+
+// [name, state, path, what to do before the shot, full page]
+const shots: [string, string, string, Action, boolean][] = [
+  ['plan-step', 'auto-step', '/plan', null, true],
+  ['plan-propose', 'propose', '/plan', null, true],
+  ['plan-hold', 'auto-hold', '/plan', null, false],
+  ['plan-steps-guard', 'auto-steps', '/plan', null, false],
+  ['plan-few-data', 'auto-few-data', '/plan', null, false],
+  ['plan-not-trusted', 'auto-not-trusted', '/plan', null, false],
+  ['plan-first-wait', 'auto-first-wait', '/plan', null, false],
+  ['plan-no-plan', 'auto-no-plan', '/plan', null, false],
+  ['plan-pending-coach', 'auto-pending', '/plan', null, true],
+  ['plan-drift', 'auto-drift', '/plan', null, true],
+  ['plan-underweight', 'auto-underweight', '/plan', null, true],
+  ['plan-bulk-up', 'auto-bulk-up', '/plan', null, false],
+  ['plan-few-carbs', 'auto-few-carbs', '/plan', null, false],
+  ['plan-lean-loss', 'auto-lean-loss', '/plan', null, false],
+  ['history-step', 'auto-step', '/plan', 'history', false],
+  ['settings-autopilot', 'auto-step', '/plan/autopilot', null, true],
+  ['settings-propose', 'propose', '/plan/autopilot', null, true],
+  ['settings-turn-on', 'propose', '/plan/autopilot', 'turn-on', false],
+  ['settings-drift-full', 'auto-drift', '/plan/autopilot', null, false],
+  ['plan-list-row', 'auto-step', '/plan', 'you', false],
+  ['day-step', 'auto-step', '/', null, false],
+  ['day-hold', 'auto-hold', '/', null, false],
+  ['day-few-data', 'auto-few-data', '/', null, false],
+  ['day-proposal', 'propose', '/', null, false],
+  ['day-morning', 'auto-step', '/?summary=TODAY', 'morning', false],
+  ['messages', 'auto-step', '/proto/messages', null, true],
+]
+
+// Which combinations of each: all four of the main ones; one of the rest.
+const main = new Set(['plan-step', 'plan-drift', 'settings-autopilot', 'day-step', 'day-morning'])
+const variants = (name: string): [string, string, string][] => {
+  if (name === 'messages') {
+    return [['desktop', 'light', 'en']]
+  }
+  if (main.has(name)) {
+    return [
+      ['phone', 'light', 'en'],
+      ['phone', 'dark', 'hr'],
+      ['desktop', 'light', 'en'],
+      ['desktop', 'dark', 'en'],
+      ['phone', 'light', 'hr'],
+    ]
+  }
+  return [['phone', 'light', 'en']]
+}
+
+const today = new Date().toLocaleDateString('sv', { timeZone: 'Europe/Zagreb' })
+
+async function setLocale(page: Page, locale: string) {
+  const r = await page.request.patch(`${base}/api/v1/me`, { data: { locale } })
+  if (!r.ok()) {
+    throw new Error(`locale: ${String(r.status())}`)
+  }
+}
+
+const browser = await chromium.launch()
+for (const device of ['phone', 'desktop'] as const) {
+  for (const theme of ['light', 'dark'] as const) {
+    const context = await browser.newContext({
+      ...(device === 'phone'
+        ? devices['Pixel 7']
+        : { viewport: { width: 1440, height: 1000 }, deviceScaleFactor: 1 }),
+      colorScheme: theme,
+      serviceWorkers: 'block',
+    })
+    await context.addInitScript((t) => {
+      localStorage.setItem('tdeemon.theme', t)
+    }, theme)
+    const page = await context.newPage()
+    await page.goto(`${base}/login`)
+    await page.getByLabel(/Email|E-pošta/).fill('ana@example.com')
+    await page.getByLabel(/Password|Lozinka/).fill('only-for-the-prototype')
+    await page.getByRole('button', { name: /Sign in|Prijavi/ }).click()
+    await page.waitForURL(`${base}/`)
+    for (const lang of ['en', 'hr']) {
+      await setLocale(page, lang)
+      for (const [name, state, path, action, full] of shots) {
+        if (!name.includes(filter)) {
+          continue
+        }
+        if (!variants(name).some(([d, t, l]) => d === device && t === theme && l === lang)) {
+          continue
+        }
+        const sep = path.includes('?') ? '&' : '?'
+        await page.goto(`${base}${path.replace('TODAY', today)}${sep}ap=${state}&shot=1`)
+        await page.waitForLoadState('networkidle')
+        await page.waitForTimeout(400)
+        if (action === 'history') {
+          await page.locator('#plan-history').scrollIntoViewIfNeeded()
+        } else if (action === 'turn-on') {
+          await page
+            .getByText(/^Autopilot$/)
+            .last()
+            .click()
+        } else if (action === 'you') {
+          await page
+            .getByRole('link', { name: /Autopilot/ })
+            .last()
+            .scrollIntoViewIfNeeded()
+        }
+        await page.waitForTimeout(300)
+        const file = `${out}${name}-${device}-${theme}-${lang}.png`
+        // A whole page on a phone is shot without its fixed bar of
+        // sections, which would sit in its middle; a screen of the plan
+        // is scrolled to the autopilot.
+        const whole = full && action === null
+        if (whole && device === 'phone') {
+          await page.addStyleTag({ content: 'nav.fixed.bottom-0 { display: none !important }' })
+        }
+        if (!whole && device === 'phone' && action === null && path === '/plan') {
+          const card = page.getByRole('region', { name: 'Autopilot', exact: true })
+          if ((await card.count()) > 0) {
+            await card.evaluate((el) => {
+              el.scrollIntoView({ block: 'start' })
+              window.scrollBy(0, -96)
+            })
+          }
+        }
+        await page.screenshot({ path: file, fullPage: whole })
+        console.log(file)
+      }
+    }
+    await setLocale(page, 'en')
+    await context.close()
+  }
+}
+await browser.close()
