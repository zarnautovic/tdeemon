+import { useApUi } from '@/components/autopilot/words'
+import { useFormat } from '@/i18n/format'
+import { cn } from '@/lib/utils'
+import type { Drift } from '@/proto/types'
+
+// DriftMeter is how far the autopilot moved the target since the last
+// one the user agreed to, against the limit: its net kcal, signed, of the
+// limit, as a bar; in the warning's colour once the next step would pass
+// it, and then said in words, as the next step is proposed instead.
+export function DriftMeter({
+  drift,
+  step,
+  compact = false,
+}: {
+  drift: Drift
+  step: number
+  compact?: boolean
+}) {
+  const f = useFormat()
+  const a = useApUi()
+  const used = Math.abs(drift.used_kcal)
+  const full = used + step > drift.limit_kcal
+
+  return (
+    <div className="space-y-1.5">
+      <div className="flex items-baseline justify-between gap-2">
+        <span className={compact ? 'text-h3' : 'font-semibold'}>
+          {a.driftValue(f.signed(drift.used_kcal), f.number(drift.limit_kcal))}
+        </span>
+        {!compact && (
+          <span className="text-small text-muted-foreground">
+            {a.driftLeft(f.number(Math.max(0, drift.limit_kcal - used)))}
+          </span>
+        )}
+      </div>
+      <progress
+        aria-label={a.drift}
+        aria-valuetext={a.driftValue(f.signed(drift.used_kcal), f.number(drift.limit_kcal))}
+        max={drift.limit_kcal}
+        value={Math.min(used, drift.limit_kcal)}
+        className={cn(
+          'block h-2 w-full appearance-none overflow-hidden rounded-full bg-surface-2 [&::-moz-progress-bar]:rounded-full [&::-webkit-progress-bar]:bg-surface-2 [&::-webkit-progress-value]:rounded-full',
+          compact && 'bg-card [&::-webkit-progress-bar]:bg-card',
+          full
+            ? '[&::-moz-progress-bar]:bg-warning [&::-webkit-progress-value]:bg-warning'
+            : '[&::-moz-progress-bar]:bg-primary [&::-webkit-progress-value]:bg-primary',
+        )}
+      />
+      {full && <p className="text-caption text-warning">{a.driftFull}</p>}
+    </div>
+  )
+}
diff --git a/web/src/components/autopilot/rationale.tsx b/web/src/components/autopilot/rationale.tsx
new file mode 100644
index 0000000..5a5d25f
--- /dev/null
+++ b/web/src/components/autopilot/rationale.tsx
@@ -0,0 +1,40 @@
+import { useApUi, useLang, useReview } from '@/components/autopilot/words'
+import { useRationale } from '@/components/plan/change-words'
+import { pastDrift } from '@/proto/copy'
+import type { ApProposal } from '@/proto/scenarios'
+import { useAutopilot } from '@/proto/store'
+
+// Rationale is why a change of the plan was made: a coach's words, the
+// app's code in the language, or, for the autopilot's (the code
+// `autopilot`), its weekly review said from its numbers: the decision,
+// then why. One it proposed past its drift limit says so, and what an
+// answer does.
+export function Rationale({ proposal, brief = false }: { proposal: ApProposal; brief?: boolean }) {
+  const rationale = useRationale()
+  const say = useReview()
+  const a = useApUi()
+  const lang = useLang()
+  const ap = useAutopilot()
+  const c = proposal.check_in
+  if (proposal.rationale !== 'autopilot' || c === undefined) {
+    return <p className="whitespace-pre-line">{rationale(proposal.rationale)}</p>
+  }
+  const words = say(c)
+
+  return (
+    <div className="space-y-1">
+      <p className="font-medium">{words.headline}</p>
+      {(brief ? words.why.slice(0, 1) : words.why).map((w) => (
+        <p key={w} className="text-sm text-muted-foreground">
+          {w}
+        </p>
+      ))}
+      {c.past_drift === true && proposal.status === 'pending' && (
+        <div className="mt-2 space-y-0.5 rounded-md border border-warning/40 bg-warning/10 p-3 text-sm">
+          <p className="font-semibold text-warning">{a.pastDriftTitle}</p>
+          <p>{pastDrift(lang, c, ap)}</p>
+        </div>
+      )}
+    </div>
+  )
+}
