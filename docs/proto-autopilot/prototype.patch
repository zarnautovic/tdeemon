+// PROTOTYPE ONLY (branch proto/autopilot, never merged). The state the
+// prototype shows: which of the scenarios (?ap=<id>, kept for the tab),
+// and what the user did to it since (the autonomy and the review day
+// changed, a proposal accepted or rejected, a step taken back), as the
+// server would hold it.
+
+import { useSyncExternalStore } from 'react'
+
+import { addDays } from '@/i18n/format'
+
+import { build, type ApProposal, type Scenario } from './scenarios'
+import type { Autopilot, Weekday } from './types'
+
+const key = 'tdeemon.proto.autopilot'
+
+function today(): string {
+  // Europe/Zagreb, the prototype's user's; close enough for a mock.
+  return new Date().toLocaleDateString('sv', { timeZone: 'Europe/Zagreb' })
+}
+
+export const scenarios = build(today())
+
+function initial(): string {
+  const asked = new URLSearchParams(globalThis.location.search).get('ap')
+  if (asked !== null && scenarios.some((s) => s.id === asked)) {
+    return asked
+  }
+  try {
+    const kept = globalThis.sessionStorage.getItem(key)
+    if (kept !== null && scenarios.some((s) => s.id === kept)) {
+      return kept
+    }
+  } catch {
+    // No storage: the first.
+  }
+  return 'auto-step'
+}
+
+function first(): Scenario {
+  const s = scenarios.find((x) => x.id === initial()) ?? scenarios[0]
+  if (s === undefined) {
+    throw new Error('no scenarios')
+  }
+  return s
+}
+
+let state: Scenario = structuredClone(first())
+const listeners = new Set<() => void>()
+
+function emit(next: Scenario) {
+  state = next
+  try {
+    globalThis.sessionStorage.setItem(key, next.id)
+  } catch {
+    // The tab forgets it.
+  }
+  for (const l of listeners) {
+    l()
+  }
+}
+
+export function scenario(): Scenario {
+  return state
+}
+
+export function choose(id: string) {
+  const s = scenarios.find((x) => x.id === id)
+  if (s !== undefined) {
+    emit(structuredClone(s))
+  }
+}
+
+export function useScenario(): Scenario {
+  return useSyncExternalStore(
+    (l) => {
+      listeners.add(l)
+      return () => listeners.delete(l)
+    },
+    () => state,
+  )
+}
+
+// useAutopilot is what GET /api/v1/autopilot would answer.
+export function useAutopilot(): Autopilot {
+  return useScenario().autopilot
+}
+
+// PUT /api/v1/autopilot: the autonomy and the review day, a web session's.
+export function setAutopilot(change: { mode?: Autopilot['mode']; weekday?: Weekday }) {
+  const ap = { ...state.autopilot, ...change }
+  if (change.weekday !== undefined) {
+    // The next review is the next such day, from tomorrow on.
+    const names = ['sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday']
+    const from = addDays(today(), 1)
+    let d = from
+    while (names[new Date(`${d}T00:00:00Z`).getUTCDay()] !== change.weekday) {
+      d = addDays(d, 1)
+    }
+    ap.next = d
+  }
+  emit({ ...state, autopilot: ap })
+}
+
+function now(): string {
+  return new Date().toISOString()
+}
+
+// The answers to a proposal of the prototype's, and a step taken back.
+export function answer(id: string, action: 'apply' | 'reject' | 'revert'): ApProposal | undefined {
+  if (action === 'revert') {
+    const rev = state.revisions.find((r) => r.id === id)
+    const ch = rev?.changes.targets[0]
+    if (rev === undefined || ch?.before === undefined) {
+      return undefined
+    }
+    const back: ApProposal = {
+      id: `${id.slice(0, -4)}ffff`,
+      by: { client: 'web' },
+      rationale: 'taken back in the app',
+      status: 'applied',
+      created_at: now(),
+      decided_at: now(),
+      expires_at: now(),
+      reverts: id,
+      changes: {
+        phases: [],
+        targets: [{ from: today(), ...(ch.after && { before: ch.after }), after: ch.before }],
+        limits: [],
+      },
+    }
+    emit({
+      ...state,
+      revisions: [
+        back,
+        ...state.revisions.map((r) => (r.id === id ? { ...r, status: 'reverted' as const } : r)),
+      ],
+      targets: [
+        ...state.targets.filter((t) => t.effective_from < today()),
+        { effective_from: today(), ...ch.before },
+      ],
+    })
+    return back
+  }
+  const p = state.pending
+  if (p?.id !== id) {
+    return undefined
+  }
+  if (action === 'reject') {
+    emit({
+      ...state,
+      pending: undefined,
+      autopilot: {
+        ...state.autopilot,
+        last: state.autopilot.last && { ...state.autopilot.last, answer: 'rejected' },
+      },
+    })
+    return { ...p, status: 'rejected' }
+  }
+  const applied: ApProposal = {
+    ...p,
+    status: 'applied',
+    decided_at: now(),
+    decided_by: { client: 'web' },
+  }
+  const after = p.changes.targets[0]?.after
+  // Accepting a target the autopilot proposed makes it one the user
+  // agreed to: the drift starts again at 0 from it.
+  const avg =
+    after === undefined
+      ? state.autopilot.drift.base_kcal
+      : Math.round((3 * after.training.kcal + 4 * after.rest.kcal) / 7)
+  emit({
+    ...state,
+    pending: undefined,
+    revisions: [applied, ...state.revisions],
+    targets:
+      after === undefined
+        ? state.targets
+        : [
+            ...state.targets.filter((t) => t.effective_from < (p.changes.targets[0]?.from ?? '')),
+            { effective_from: p.changes.targets[0]?.from ?? today(), ...after },
+          ],
+    phases: [
+      ...state.phases,
+      ...p.changes.phases.flatMap((ph) => (ph.after === undefined ? [] : [ph.after])),
+    ],
+    autopilot: {
+      ...state.autopilot,
+      drift: { ...state.autopilot.drift, used_kcal: 0, base_kcal: avg, base_from: today() },
+      last: state.autopilot.last && { ...state.autopilot.last, answer: 'accepted' },
+    },
+  })
+  return applied
+}
