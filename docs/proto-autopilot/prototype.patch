+// PROTOTYPE ONLY (proto/autopilot): the autopilot's words in the app's
+// language (web/src/proto/copy.ts).
+
+import { useLocale } from '@/i18n/locale'
+import { review, uiOf, type Lang } from '@/proto/copy'
+import { useAutopilot } from '@/proto/store'
+import type { CheckIn } from '@/proto/types'
+
+export function useLang(): Lang {
+  return useLocale() === 'hr' ? 'hr' : 'en'
+}
+
+export function useApUi() {
+  return uiOf(useLang())
+}
+
+// useReview says a weekly review in the language.
+export function useReview() {
+  const lang = useLang()
+  const ap = useAutopilot()
+  return (c: CheckIn) => review(lang, c, ap)
+}
