@@ -0,0 +1,222 @@
+import { Ban, Check, Hourglass, ShieldCheck } from 'lucide-react'
+import { useEffect, useId, useRef, useState } from 'react'
+
+import { $api } from '@/api/client'
+import { DriftMeter } from '@/components/autopilot/drift-meter'
+import { useApUi, useLang } from '@/components/autopilot/words'
+import { ListGroup } from '@/components/list-group'
+import { ListRow } from '@/components/list-row'
+import { useDate } from '@/components/plan/proposal-text'
+import { SubPage } from '@/components/sub-page'
+import { Button } from '@/components/ui/button'
+import { ChipGroup } from '@/components/ui/chip-group'
+import { SegmentedControl } from '@/components/ui/segmented'
+import { useFormat } from '@/i18n/format'
+import { sayChange } from '@/lib/toast'
+import { weekdayWords } from '@/proto/copy'
+import { setAutopilot, useAutopilot } from '@/proto/store'
+import type { Autopilot, Weekday } from '@/proto/types'
+
+const week: Weekday[] = [
+  'monday',
+  'tuesday',
+  'wednesday',
+  'thursday',
+  'friday',
+  'saturday',
+  'sunday',
+]
+
+// AutopilotPage is the autopilot's settings, a web session's only (a
+// coach cannot turn it on): whether it applies its weekly step itself or
+// asks first, which turned on asks first, saying what that means; the
+// day of its weekly review; in autopilot the drift so far against the
+// limit; what it may change, what it never changes and when it waits;
+// and its limits, a row to the plan's limits.
+export function AutopilotPage() {
+  const ap = useAutopilot()
+  const a = useApUi()
+  const lang = useLang()
+  const f = useFormat()
+  const date = useDate()
+  const id = useId()
+  const limits = $api.useQuery('get', '/api/v1/limits')
+  const holds = limits.data?.effective
+  // The mode asked about, before it is turned on.
+  const [asking, setAsking] = useState(false)
+  const back = useRef<HTMLButtonElement>(null)
+  useEffect(() => {
+    if (asking) {
+      back.current?.focus()
+    }
+  }, [asking])
+  const stepKcal = holds?.step_kcal ?? 100
+  const stepPct = holds?.step_pct ?? 5
+  const driftPct = holds?.drift_pct ?? ap.drift.limit_pct
+  const save = (mode: Autopilot['mode']) => {
+    setAutopilot({ mode })
+    setAsking(false)
+    sayChange({ title: a.savedMode[mode] })
+  }
+
+  return (
+    <SubPage
+      title={a.name}
+      titleId={id}
+      from="plan"
+      hint={
+        lang === 'en'
+          ? 'A weekly review of your pace that moves your kcal target in small steps.'
+          : 'Tjedni pregled tempa koji u malim koracima pomiče tvoj cilj kcal.'
+      }
+    >
+      <section className="space-y-3 rounded-lg border bg-card p-4 shadow-card">
+        <SegmentedControl
+          legend={lang === 'en' ? 'When the review finds a step' : 'Kad pregled nađe korak'}
+          options={[
+            { value: 'propose', label: a.modes.propose },
+            { value: 'autopilot', label: a.modes.autopilot },
+          ]}
+          value={asking ? 'autopilot' : ap.mode}
+          onChange={(mode) => {
+            if (mode === 'autopilot') {
+              setAsking(true)
+            } else {
+              save('propose')
+            }
+          }}
+        />
+        <p className="text-sm text-muted-foreground" aria-live="polite">
+          {a.modeHint[asking ? 'autopilot' : ap.mode]}
+        </p>
+        {asking && (
+          <div className="space-y-2 rounded-lg border border-primary/40 bg-primary-soft/40 p-3 text-sm">
+            <p id={`${id}-ask`} className="font-semibold">
+              {a.turnOn}
+            </p>
+            <p>
+              {a.turnOnText(
+                f.number(stepKcal),
+                f.number(Math.round((ap.drift.tdee_kcal * driftPct) / 100)),
+              )}
+            </p>
+            <div className="flex gap-2">
+              <Button
+                onClick={() => {
+                  save('autopilot')
+                }}
+              >
+                {a.turnOnYes}
+              </Button>
+              <Button
+                ref={back}
+                variant="ghost"
+                onClick={() => {
+                  setAsking(false)
+                }}
+              >
+                {a.turnOnNo}
+              </Button>
+            </div>
+          </div>
+        )}
+      </section>
+
+      <section
+        aria-labelledby={`${id}-day`}
+        className="space-y-2 rounded-lg border bg-card p-4 shadow-card"
+      >
+        <h2 id={`${id}-day`} className="font-semibold">
+          {a.day}
+        </h2>
+        <ChipGroup
+          legend={a.day}
+          options={week.map((d) => ({ value: d, label: weekdayWords(lang, d)[0] }))}
+          value={ap.weekday}
+          onChange={(weekday) => {
+            setAutopilot({ weekday })
+            sayChange({ title: a.savedDay })
+          }}
+        />
+        <p className="text-sm text-muted-foreground">
+          {a.dayHint(`${f.weekday(ap.next)}, ${date(ap.next)}`)}
+        </p>
+      </section>
+
+      {ap.mode === 'autopilot' && (
+        <section
+          aria-labelledby={`${id}-drift`}
+          className="space-y-2 rounded-lg border bg-card p-4 shadow-card"
+        >
+          <h2 id={`${id}-drift`} className="font-semibold">
+            {a.drift}
+          </h2>
+          <DriftMeter drift={ap.drift} step={ap.step_kcal} />
+          <p className="text-sm text-muted-foreground">
+            {a.driftHint(f.number(ap.drift.base_kcal), date(ap.drift.base_from))}
+          </p>
+        </section>
+      )}
+
+      <section className="space-y-4 rounded-lg border bg-card p-4 shadow-card">
+        <Rules
+          title={a.mayTitle}
+          icon={<Check aria-hidden className="mt-0.5 size-4 shrink-0 text-success" />}
+          items={a.may(
+            f.number(stepKcal),
+            f.percent(stepPct, 0),
+            f.number(Math.round((ap.drift.tdee_kcal * driftPct) / 100)),
+            f.percent(driftPct, 0),
+          )}
+        />
+        <Rules
+          title={a.neverTitle}
+          icon={<Ban aria-hidden className="mt-0.5 size-4 shrink-0 text-muted-foreground" />}
+          items={a.never}
+        />
+        <Rules
+          title={a.waitsTitle}
+          icon={<Hourglass aria-hidden className="mt-0.5 size-4 shrink-0 text-muted-foreground" />}
+          items={a.waits(holds?.logged_days ?? 4, holds?.weigh_ins ?? 3)}
+        />
+        <p className="border-t pt-3 text-sm text-muted-foreground">{a.undoNote}</p>
+      </section>
+
+      <ListGroup>
+        <ListRow
+          icon={ShieldCheck}
+          title={a.limitsRow}
+          to="/plan/limits"
+          summary={a.limitsSummary(f.number(stepKcal), f.percent(driftPct, 0))}
+        />
+      </ListGroup>
+    </SubPage>
+  )
+}
+
+function Rules({
+  title,
+  icon,
+  items,
+}: {
+  title: string
+  icon: React.ReactNode
+  items: readonly string[]
+}) {
+  const id = useId()
+  return (
+    <section aria-labelledby={id} className="space-y-1.5">
+      <h2 id={id} className="font-semibold">
+        {title}
+      </h2>
+      <ul className="space-y-1.5">
+        {items.map((item) => (
+          <li key={item} className="flex gap-2 text-sm">
+            {icon}
+            <span>{item}</span>
+          </li>
+        ))}
+      </ul>
+    </section>
+  )
+}
