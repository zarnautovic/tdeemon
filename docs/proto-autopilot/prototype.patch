+    }
+    const pending: ApProposal = {
+      id: id(),
+      by: { client: 'autopilot' },
+      rationale: 'autopilot',
+      status: 'pending',
+      created_at: at(today),
+      expires_at: at(addDays(today, 7)),
+      changes: {
+        phases: [],
+        targets: [{ from: today, before: values(2350, 2050), after: values(2250, 1950) }],
+        limits: [],
+      },
+      check_in: check,
+    }
+    check.proposal_id = pending.id
+    scenarios.push({
+      id: 'propose',
