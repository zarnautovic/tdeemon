+// PROTOTYPE ONLY (branch proto/autopilot, never merged). The fields the
+// autopilot's API would give the web app, as docs/proto-autopilot/
+// DESIGN-autopilot.md proposes them: what GET /api/v1/autopilot answers,
+// and what a proposal or a revision the autopilot made carries
+// (ProposalBody.check_in). The app fakes them (web/src/proto/mock.ts).
+
+import type { components } from '@/api/schema'
+
+export type Weekday = components['schemas']['PlanBody']['training_weekdays'][number]
+
+// Outcome is what a weekly review came to: a step applied (autopilot), a
+// step or a plan change proposed (propose; past the drift limit;
+// underweight), a hold, or no step for a reason.
+export type Outcome = 'applied' | 'proposed' | 'hold' | 'skipped'
+
+// Reason is why: the verdict's action for a step or a proposal, what held
+// it, or what kept it from a step at all.
+export type Reason =
+  // a step down or up, by the verdict's rate or a guard
+  | 'cut_slow'
+  | 'cut_fast'
+  | 'bulk_slow'
+  | 'bulk_fast'
+  | 'bulk_fat'
+  | 'lean_loss'
+  // hold
+  | 'on_target'
+  | 'steps_guard'
+  // no step
+  | 'not_trusted'
+  | 'no_plan'
+  | 'few_data'
+  | 'first_wait'
+  | 'interval'
+  | 'pending'
+  | 'few_carbs'
+  // a proposal instead of a step
+  | 'underweight'
+
+// CheckIn is one weekly review, with the verdict's numbers the app says
+// it in: each language its own way, from the code `autopilot`.
+export interface CheckIn {
+  date: string
+  outcome: Outcome
+  reason: Reason
+  // The step, signed: −100 lowers the weekly average 100 kcal a day.
+  step_kcal?: number
+  // Past the drift limit: the step it would have applied, proposed.
+  past_drift?: boolean
+  proposal_id?: string
+  // The verdict.
+  phase?: 'cut' | 'maintain' | 'bulk' | 'recomp'
+  measured_pct_week?: number
+  target_pct_week?: number
+  tolerance_pct_week?: number
+  tdee_kcal?: number
+  tdee_half_width?: number
+  intake_kcal?: number
+  // The weekly average of the target before the step, and after it.
+  target_kcal?: number
+  after_kcal?: number
+  // The data of the last 7 days, against what a step needs.
+  logged_days?: number
+  weigh_ins?: number
+  needs_logged_days?: number
+  needs_weigh_ins?: number
+  // The steps guard: the last 7 days' steps against the weeks before, %.
+  steps_change_pct?: number
+  // A first step's day (14 days into a phase or from a target agreed);
+  // when calibration expects a TDEE to trust (calibration.Expected).
+  from?: string
+  expected?: string
+  // The rest days' carbs, for a target with too few for a step down.
+  carbs_g?: number
+  // Underweight: the BMI now.
+  bmi?: number
+  // What the user answered its proposal, once they did.
+  answer?: 'accepted' | 'rejected'
+}
+
+// Drift is how far the autopilot moved the weekly average, net, since
+// the last kcal target the user agreed to, against the limit.
+export interface Drift {
+  used_kcal: number
+  limit_kcal: number
+  limit_pct: number
+  base_kcal: number
+  base_from: string
+  tdee_kcal: number
+}
+
+// Autopilot is GET /api/v1/autopilot: the user's autonomy and review day
+// (PUT, a web session only), the next review, the drift, the step its
+// limits allow now, and the last review.
+export interface Autopilot {
+  mode: 'propose' | 'autopilot'
+  weekday: Weekday
+  next: string
+  step_kcal: number
+  drift: Drift
+  last?: CheckIn | undefined
+}
