diff --git a/web/src/proto/mock.ts b/web/src/proto/mock.ts
new file mode 100644
index 0000000..03fca86
--- /dev/null
+++ b/web/src/proto/mock.ts
@@ -0,0 +1,109 @@
+// PROTOTYPE ONLY (branch proto/autopilot, never merged). Fakes, over the
+// real server's answers, what the autopilot would add to them: the plan
+// of the scenario chosen (its phases, targets, revisions and the proposal
+// that waits, the autopilot's among them), calibration's TDEE and verdict
+// of it, the morning summary's line, and the answers to the prototype's
+// own proposals. Everything else is the server's.
+
+import type { Middleware } from 'openapi-fetch'
+
+import { review } from './copy'
+import { answer, scenario } from './store'
+
+const ours = '00000000-0000-7000-8000-'
+
+async function rewrite(response: Response, edit: (body: Record<string, unknown>) => unknown) {
+  const body: unknown = await response.clone().json()
+  const record: Record<string, unknown> = {}
+  if (typeof body === 'object' && body !== null) {
+    Object.assign(record, body)
+  }
+  return new Response(JSON.stringify(edit(record)), {
+    status: response.status,
+    headers: response.headers,
+  })
+}
+
+function obj(v: unknown): object {
+  return typeof v === 'object' && v !== null ? v : {}
+}
+
+export const protoMiddleware: Middleware = {
+  onRequest({ request, schemaPath }) {
+    const m = /^\/api\/v1\/proposals\/\{id\}\/(apply|reject|revert)$/.exec(schemaPath)
+    const id = new URL(request.url).pathname.split('/')[4] ?? ''
+    const action = m?.[1]
+    if ((action === 'apply' || action === 'reject' || action === 'revert') && id.startsWith(ours)) {
+      const done = answer(id, action)
+      return new Response(JSON.stringify({ proposal: done }), {
+        status: done === undefined ? 409 : 200,
+        headers: { 'Content-Type': 'application/json' },
+      })
+    }
+    return undefined
+  },
+  async onResponse({ request, response, schemaPath }) {
+    if (request.method !== 'GET' || !response.ok) {
+      return undefined
+    }
+    const s = scenario()
+    if (schemaPath === '/api/v1/plan') {
+      return rewrite(response, (b) => {
+        const plan = {
+          ...b,
+          phases: s.phases,
+          targets: s.targets,
+          training_weekdays: s.training_weekdays,
+          revisions: s.revisions,
+          pending: s.pending,
+        }
+        delete (plan as Record<string, unknown>).pending_preview
+        return plan
+      })
+    }
+    if (schemaPath === '/api/v1/summary') {
+      return rewrite(response, (b) => ({
+        ...b,
+        tdee: { ...obj(b.tdee), ...s.tdee },
+        verdict: { ...obj(b.verdict), ...s.verdict },
+      }))
+    }
+    if (schemaPath === '/api/v1/morning') {
+      return rewrite(response, (b) => {
+        const text = String(b.text)
+        const last = s.autopilot.last
+        if (last === undefined) {
+          return b
+        }
+        const hr = text.startsWith('Jutarnji')
+        const words = review(hr ? 'hr' : 'en', last, s.autopilot)
+        // The autopilot's line, after the calibration's: what changed in
+        // the plan this morning, before the rest of the plan's.
+        const lines = text.split('\n')
+        const at = lines.findIndex((l) => l.startsWith(hr ? 'Kalibracija:' : 'Calibration:'))
+        // The calibration's line of the scenario's verdict, as the server
+        // writes it (internal/api/morning.go), for the two to agree.
+        const m = last.measured_pct_week
+        const p = last.target_pct_week
+        if (at >= 0 && m !== undefined && p !== undefined) {
+          const pct = (x: number) =>
+            new Intl.NumberFormat(hr ? 'hr' : 'en', {
+              minimumFractionDigits: 2,
+              maximumFractionDigits: 2,
+              signDisplay: 'exceptZero',
+            }).format(x)
+          const rate = s.verdict?.rate ?? 'none'
+          const said = hr
+            ? { on_target: 'u planu', below: 'ispod plana', above: 'iznad plana', none: '' }
+            : { on_target: 'on plan', below: 'below plan', above: 'above plan', none: '' }
+          lines[at] = hr
+            ? `Kalibracija: tempo ${pct(m)} %/tj, cilj ${pct(p)} %/tj, ${said[rate]}`
+            : `Calibration: rate ${pct(m)} %/wk, target ${pct(p)} %/wk, ${said[rate]}`
+        }
+        lines.splice(at < 0 ? lines.length : at + 1, 0, `Autopilot: ${words.morning}`)
+        return { ...b, text: lines.join('\n') }
+      })
+    }
+    return undefined
+  },
+}
