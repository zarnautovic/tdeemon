@@ -0,0 +1,157 @@
+import { Link } from '@tanstack/react-router'
+import { ChevronRight, Gauge } from 'lucide-react'
+import { useId } from 'react'
+
+import { DriftMeter } from '@/components/autopilot/drift-meter'
+import { useApUi, useLang, useReview } from '@/components/autopilot/words'
+import { useDate } from '@/components/plan/proposal-text'
+import { Badge } from '@/components/ui/badge'
+import { buttonVariants } from '@/components/ui/button'
+import { useFormat } from '@/i18n/format'
+import { cn } from '@/lib/utils'
+import { weekdayWords } from '@/proto/copy'
+import { useAutopilot, useScenario } from '@/proto/store'
+
+// The tone of a review's decision: a step's the brand's, a proposal's the
+// warning's (it waits for the user), a hold or no step plain.
+const tones = {
+  applied: 'bg-primary',
+  proposed: 'bg-warning',
+  hold: 'bg-success',
+  skipped: 'bg-muted-foreground',
+} as const
+
+// AutopilotCard is the autopilot on the plan: whether it applies its
+// steps or asks first, its last weekly review (what it decided, and why
+// in the verdict's numbers), when the next comes, and in autopilot how
+// far it has moved the target of the one agreed to, against the limit;
+// with its settings a tap away. A step it applied is taken back in the
+// plan's history, as any change of the plan.
+export function AutopilotCard() {
+  const ap = useAutopilot()
+  const a = useApUi()
+  const lang = useLang()
+  const f = useFormat()
+  const date = useDate()
+  const say = useReview()
+  const id = useId()
+  const last = ap.last
+  const words = last === undefined ? undefined : say(last)
+  const on = ap.mode === 'autopilot'
+  // A proposal of this review's that waits is said whole in its card
+  // above: here, only that it waits.
+  const pending = useScenario().pending
+  const waiting = last?.proposal_id !== undefined && pending?.id === last.proposal_id
+
+  return (
+    <section aria-labelledby={id} className="space-y-3 rounded-lg border bg-card p-4 lg:p-5">
+      <header className="flex items-center justify-between gap-2">
+        <div className="flex min-w-0 items-center gap-2">
+          <span
+            aria-hidden
+            className="flex size-8 shrink-0 items-center justify-center rounded-md bg-primary-soft text-primary"
+          >
+            <Gauge strokeWidth={1.75} className="size-4.5" />
+          </span>
+          <h2 id={id} className="text-h3">
+            {a.name}
+          </h2>
+          <Badge tone={on ? 'primary' : 'neutral'}>{on ? a.on : a.asks}</Badge>
+        </div>
+        <Link
+          to="/plan/autopilot"
+          aria-label={a.settings}
+          className={buttonVariants({ variant: 'ghost', size: 'sm', className: '-mr-2' })}
+        >
+          {lang === 'en' ? 'Settings' : 'Postavke'}
+          <ChevronRight aria-hidden />
+        </Link>
+      </header>
+      {last !== undefined && words !== undefined && (
+        <div className="space-y-1.5">
+          <p className="text-small text-muted-foreground">
+            {a.last} · {date(last.date)}
+          </p>
+          <p className="flex items-start gap-2 font-semibold">
+            <span
+              aria-hidden
+              className={cn('mt-2 size-2 shrink-0 rounded-full', tones[last.outcome])}
+            />
+            <span>{words.headline}</span>
+          </p>
+          {waiting && (
+            <p className="text-sm text-muted-foreground">
+              {lang === 'en' ? 'It waits for your answer, above.' : 'Čeka tvoj odgovor, gore.'}
+            </p>
+          )}
+          {!waiting && words.why[0] !== undefined && (
+            <p className="text-sm text-muted-foreground">{words.why[0]}</p>
+          )}
+          {!waiting && words.why.length > 1 && (
+            // The rest of why, a tap away: the decision and its pace say
+            // enough at a glance.
+            <details className="group text-sm text-muted-foreground">
+              <summary className="flex min-h-11 cursor-pointer list-none items-center gap-1 font-medium text-foreground marker:hidden">
+                <ChevronRight
+                  aria-hidden
+                  className="size-4 transition-transform group-open:rotate-90 motion-reduce:transition-none"
+                />
+                {lang === 'en' ? 'The numbers' : 'Brojke'}
+              </summary>
+              <div className="space-y-1.5 pb-1">
+                {words.why.slice(1).map((w) => (
+                  <p key={w}>{w}</p>
+                ))}
+              </div>
+            </details>
+          )}
+          {last.answer !== undefined && (
+            <p className="text-sm font-medium">
+              {last.answer === 'accepted' ? a.accepted : a.rejected}
+            </p>
+          )}
+          {last.outcome === 'applied' && (
+            <p className="text-sm">
+              <a
+                href="#plan-history"
+                className="font-medium text-primary underline-offset-2 hover:underline"
+              >
+                {a.takeBackHint}
+              </a>
+            </p>
+          )}
+        </div>
+      )}
+      <dl className="grid grid-cols-2 gap-3">
+        <div className="space-y-0.5 rounded-md bg-surface-2 p-3">
+          <dt className="text-small text-muted-foreground">{a.next}</dt>
+          <dd className="text-h3">{`${f.weekday(ap.next)}, ${date(ap.next)}`}</dd>
+          <dd className="text-caption text-muted-foreground">
+            {weekdayWords(lang, ap.weekday)[1]}
+          </dd>
+        </div>
+        <div className="space-y-1 rounded-md bg-surface-2 p-3">
+          <dt className="text-small text-muted-foreground">
+            {on ? a.drift : lang === 'en' ? 'Step' : 'Korak'}
+          </dt>
+          <dd>
+            {on ? (
+              <DriftMeter drift={ap.drift} step={ap.step_kcal} compact />
+            ) : (
+              <span className="text-h3">
+                {lang === 'en'
+                  ? `up to ${f.number(ap.step_kcal)} kcal`
+                  : `do ${f.number(ap.step_kcal)} kcal`}
+              </span>
+            )}
+          </dd>
+          {!on && (
+            <dd className="text-caption text-muted-foreground">
+              {lang === 'en' ? 'a day, if you accept' : 'dnevno, ako prihvatiš'}
+            </dd>
+          )}
+        </div>
+      </dl>
+    </section>
+  )
+}
