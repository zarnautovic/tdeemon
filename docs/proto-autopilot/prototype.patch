+
+const steps = (n: number) => Math.abs(n) / 4 // grams of carbs
+
+export function review(lang: Lang, c: CheckIn, ap: Autopilot): ReviewWords {
+  const f = fmt(lang)
+  const en = lang === 'en'
+  const k = (x: number | undefined) => f.n(x ?? 0)
+  const step = Math.abs(c.step_kcal ?? 0)
+  const down = (c.step_kcal ?? 0) < 0
+  const next = f.day(ap.next)
+  const measured = c.measured_pct_week ?? 0
+  const gaining = measured > 0
+  const planned = c.target_pct_week ?? 0
+  const tol = c.tolerance_pct_week ?? 0.1
+  const [lo, hi] = [Math.abs(planned - tol), Math.abs(planned + tol)].toSorted((x, y) => x - y)
+  const range = `${f.pct(lo ?? 0)} ${en ? 'to' : 'do'} ${f.pct(hi ?? 0)}`
+  const tdee = c.tdee_kcal === undefined ? '' : `${k(c.tdee_kcal)} ± ${k(c.tdee_half_width)}`
+  const pace = en
+    ? `You ${gaining ? 'gained' : 'lost'} ${f.pct(measured)} a week; the plan is ${f.pct(planned)} (${range}).`
+    : `${gaining ? 'Dobivaš' : 'Gubiš'} ${f.pct(measured)} tjedno; plan je ${f.pct(planned)} (${range}).`
+  const energy = en
+    ? `Your TDEE is ${tdee} kcal; you ate ${k(c.intake_kcal)} kcal a day against a target of ${k(c.target_kcal)}.`
+    : `TDEE je ${tdee} kcal; unos je bio ${k(c.intake_kcal)} kcal dnevno uz cilj od ${k(c.target_kcal)}.`
+  const shortPace = en
+    ? `${gaining ? 'gaining' : 'losing'} ${f.pct(measured)}/wk, plan ${f.pct(planned)}`
+    : `tempo ${f.signedPct(measured)}/tj, plan ${f.signedPct(planned)}/tj`
+  const newAvg = k(c.after_kcal)
+  const carbs = f.n(steps(step))
+  const driftAfter = ap.drift.used_kcal + (c.step_kcal ?? 0)
+
+  let headline = ''
+  let why: string[] = []
+  let line = ''
+  let title = ''
+  let body = ''
+  let morning = ''
+
+  switch (c.outcome) {
+    case 'applied': {
+      headline = en
+        ? `${down ? 'Lowered' : 'Raised'} your target by ${k(step)} kcal a day`
+        : `${down ? 'Spustio' : 'Podigao'} je cilj za ${k(step)} kcal dnevno`
+      line = en
+        ? `target ${f.signed(c.step_kcal ?? 0)} kcal a day, from today`
+        : `cilj ${f.signed(c.step_kcal ?? 0)} kcal dnevno, od danas`
+      title = en
+        ? `Target ${f.signed(c.step_kcal ?? 0)} kcal a day`
+        : `Cilj ${f.signed(c.step_kcal ?? 0)} kcal dnevno`
+      body = en
+        ? `Weekly review: ${shortPace}. New average ${newAvg} kcal a day. Tap to see why, or take it back.`
+        : `Tjedni pregled: ${shortPace}. Novi prosjek ${newAvg} kcal dnevno. Dodirni za razlog ili vraćanje.`
+      morning = en
+        ? `target ${f.signed(c.step_kcal ?? 0)} kcal/day, to ${newAvg} (${shortPace})`
+        : `cilj ${f.signed(c.step_kcal ?? 0)} kcal/dan, na ${newAvg} (${shortPace})`
+      break
+    }
+    case 'proposed': {
+      if (c.reason === 'underweight') {
+        headline = en ? 'Suggests maintenance' : 'Predlaže održavanje'
+        line = en ? 'suggests maintenance' : 'predlaže održavanje'
+        title = en ? 'Maintenance suggested' : 'Predlaže održavanje'
+        body = en
+          ? `Your BMI is ${f.n(c.bmi ?? 0, 1)}, under 18.5, so the autopilot won’t take the loss further. Accept or reject in the plan.`
+          : `BMI ti je ${f.n(c.bmi ?? 0, 1)}, ispod 18,5, pa autopilot ne nastavlja gubitak. Prihvati ili odbij u planu.`
+        morning = en
+          ? 'suggests maintenance, your BMI is under 18.5'
+          : 'predlaže održavanje, BMI je ispod 18,5'
+      } else {
+        headline = en
+          ? `Suggests ${down ? 'lowering' : 'raising'} your target by ${k(step)} kcal a day`
+          : `Predlaže ${down ? 'spustiti' : 'podići'} cilj za ${k(step)} kcal dnevno`
+        line = en
+          ? `suggests ${f.signed(c.step_kcal ?? 0)} kcal a day`
+          : `predlaže ${f.signed(c.step_kcal ?? 0)} kcal dnevno`
+        title = en
+          ? `Suggests ${f.signed(c.step_kcal ?? 0)} kcal a day`
+          : `Predlaže ${f.signed(c.step_kcal ?? 0)} kcal dnevno`
+        body = c.past_drift
+          ? en
+            ? `Weekly review: ${shortPace}. It’s past your drift limit (${f.signed(driftAfter)} of ${k(ap.drift.limit_kcal)} kcal), so it asks first. Answer by ${f.day(addWeek(c.date))}.`
+            : `Tjedni pregled: ${shortPace}. To je preko granice odstupanja (${f.signed(driftAfter)} od ${k(ap.drift.limit_kcal)} kcal), pa pita prvo. Odgovori do ${f.day(addWeek(c.date))}.`
+          : en
+            ? `Weekly review: ${shortPace}. Accept or reject in the plan by ${f.day(addWeek(c.date))}.`
+            : `Tjedni pregled: ${shortPace}. Prihvati ili odbij u planu do ${f.day(addWeek(c.date))}.`
+        morning = en
+          ? `suggests ${f.signed(c.step_kcal ?? 0)} kcal/day (${shortPace}), waits for your answer`
+          : `predlaže ${f.signed(c.step_kcal ?? 0)} kcal/dan (${shortPace}), čeka tvoj odgovor`
+      }
+      break
+    }
+    case 'hold': {
+      if (c.reason === 'steps_guard') {
+        headline = en
+          ? 'Holding: your steps explain the slower pace'
+          : 'Bez promjene: sporiji tempo objašnjavaju koraci'
+        line = en ? 'holding, your steps explain it' : 'bez promjene, objašnjavaju to koraci'
+        title = en ? 'Holding: steps explain it' : 'Bez promjene: koraci'
+        body = en
+          ? `Weekly review: ${shortPace}, but your steps fell ${f.n(Math.abs(c.steps_change_pct ?? 0))} %. The target stays ${k(c.target_kcal)} kcal.`
+          : `Tjedni pregled: ${shortPace}, ali koraka je ${f.n(Math.abs(c.steps_change_pct ?? 0))} % manje. Cilj ostaje ${k(c.target_kcal)} kcal.`
+        morning = en
+          ? `holding, steps ${f.signed(c.steps_change_pct ?? 0)} % explain the pace`
+          : `bez promjene, koraci ${f.signed(c.steps_change_pct ?? 0)} % objašnjavaju tempo`
+      } else {
+        headline = en ? 'Holding: your pace is on plan' : 'Bez promjene: tempo je u planu'
+        line = en ? 'holding, pace on plan' : 'bez promjene, tempo u planu'
+        title = en ? 'Holding: pace on plan' : 'Bez promjene: tempo u planu'
+        body = en
+          ? `Weekly review: ${shortPace}. The target stays ${k(c.target_kcal)} kcal a day.`
+          : `Tjedni pregled: ${shortPace}. Cilj ostaje ${k(c.target_kcal)} kcal dnevno.`
+        morning = en
+          ? `holding, pace on plan (${shortPace})`
+          : `bez promjene, tempo u planu (${shortPace})`
+      }
+      break
+    }
+    case 'skipped': {
+      const no = en ? 'No step' : 'Bez koraka'
+      const short: Record<string, [string, string]> = {
+        few_data:
+          (c.logged_days ?? 0) < (c.needs_logged_days ?? 4)
+            ? en
+              ? [
+                  `${String(c.logged_days)} of ${String(c.needs_logged_days)} logged days`,
+                  `${String(c.logged_days)}/${String(c.needs_logged_days)} logged days`,
+                ]
+              : [
+                  `${String(c.logged_days)} od ${String(c.needs_logged_days)} upisana dana`,
+                  `${String(c.logged_days)}/${String(c.needs_logged_days)} upisana dana`,
+                ]
+            : en
+              ? [
+                  `${String(c.weigh_ins)} of ${String(c.needs_weigh_ins)} weigh-ins`,
+                  `${String(c.weigh_ins)}/${String(c.needs_weigh_ins)} weigh-ins`,
+                ]
+              : [
+                  `${String(c.weigh_ins)} od ${String(c.needs_weigh_ins)} vaganja`,
+                  `${String(c.weigh_ins)}/${String(c.needs_weigh_ins)} vaganja`,
+                ],
+        not_trusted: en
+          ? ['your TDEE isn’t trusted yet', 'TDEE not trusted yet']
+          : ['TDEE još nije pouzdan', 'TDEE još nije pouzdan'],
+        first_wait: en
+          ? ['the phase is new', 'the phase is new']
+          : ['faza je nova', 'faza je nova'],
+        interval: en
+          ? ['7 days since the last step', '7 days since the last']
+          : ['7 dana od zadnjeg koraka', '7 dana od zadnjeg'],
+        pending: en
+          ? ['a proposal waits for your answer', 'a proposal waits']
+          : ['prijedlog čeka tvoj odgovor', 'prijedlog čeka'],
+        few_carbs: en
+          ? ['too few carbs to lower', 'too few carbs']
+          : ['premalo ugljikohidrata za spuštanje', 'premalo UH'],
+        no_plan: en
+          ? ['no phase or target', 'no phase or target']
+          : ['nema faze ni cilja', 'nema faze ni cilja'],
+      }
+      const [long, brief] = short[c.reason] ?? ['', '']
+      headline = `${no}: ${long}`
+      line = `${en ? 'no step' : 'bez koraka'}, ${brief}`
+      title = `${no}: ${brief}`
+      morning = `${en ? 'no step' : 'bez koraka'}, ${brief}`
+      const nextReview = en ? `Next review ${next}.` : `Sljedeći pregled ${next}.`
+      const bodies: Record<string, string> = {
+        few_data: en
+          ? `A step needs ${String(c.needs_logged_days)} logged days and ${String(c.needs_weigh_ins)} weigh-ins in the last 7. ${nextReview}`
+          : `Korak treba ${String(c.needs_logged_days)} upisana dana i ${String(c.needs_weigh_ins)} vaganja u zadnjih 7. ${nextReview}`,
+        not_trusted: en
+          ? `Your TDEE is about ${tdee} kcal. A first step about ${f.day(c.expected ?? ap.next)}, if you keep logging as now.`
+          : `TDEE je oko ${tdee} kcal. Prvi korak oko ${f.day(c.expected ?? ap.next)}, ako nastaviš upisivati kao sada.`,
+        first_wait: en
+          ? `A phase’s first 14 days move water as much as fat. The first step can come from ${f.day(c.from ?? ap.next)}.`
+          : `Prvih 14 dana faze miče vodu koliko i mast. Prvi korak može doći od ${f.day(c.from ?? ap.next)}.`,
+        pending: en
+          ? `Answer the proposal in your plan first; the review waits for it. ${nextReview}`
+          : `Prvo odgovori na prijedlog u planu; pregled ga čeka. ${nextReview}`,
+        few_carbs: en
+          ? `Rest days have ${f.n(c.carbs_g ?? 0)} g carbs, and it never changes protein or fat. Ask your coach to change the split.`
+          : `Dani odmora imaju ${f.n(c.carbs_g ?? 0)} g UH, a proteine i masti nikad ne mijenja. Zamoli trenera da promijeni raspodjelu.`,
+        no_plan: en
+          ? 'Set a phase and a kcal target in your plan, and the review judges your pace against them.'
+          : 'Postavi fazu i cilj kcal u planu, pa će pregled ocjenjivati tempo prema njima.',
+        interval: nextReview,
+      }
+      body = bodies[c.reason] ?? nextReview
+      break
+    }
+  }
+
+  // Why, in the app: the numbers whole.
+  const reasons: Record<string, string[]> = {
+    cut_slow: [pace, energy],
+    cut_fast: [pace, energy],
+    bulk_slow: [pace, energy],
+    bulk_fast: [pace, energy],
+    bulk_fat: [
+      en
+        ? 'Your body fat rose beyond its error while lean mass stayed flat: a smaller surplus, never below your TDEE.'
+        : 'Tjelesna mast je rasla više od pogreške mjerenja, a nemasna masa stoji: manji suficit, nikad ispod TDEE-a.',
+      energy,
+    ],
+    lean_loss: [
+      en
+        ? `You lost ${f.pct(measured)} a week, and lean mass with it beyond its error. A step up keeps more of it.`
+        : `Gubiš ${f.pct(measured)} tjedno, a s tim i nemasnu masu, više od pogreške mjerenja. Korak gore čuva više nje.`,
+      energy,
+    ],
+    on_target: [pace, energy],
+    steps_guard: [
+      pace,
+      en
+        ? `Your steps fell ${f.n(Math.abs(c.steps_change_pct ?? 0))} % from the weeks before. That explains the slower pace, not your metabolism, so the target holds.`
+        : `Koraka je ${f.n(Math.abs(c.steps_change_pct ?? 0))} % manje nego prethodnih tjedana. To objašnjava sporiji tempo, a ne metabolizam, pa cilj ostaje.`,
+    ],
+    few_data: [
+      en
+        ? `A step needs ${String(c.needs_logged_days)} logged days and ${String(c.needs_weigh_ins)} weigh-ins in the last 7 days. This week had ${String(c.logged_days)} logged days and ${String(c.weigh_ins)} weigh-ins.`
+        : `Korak treba ${String(c.needs_logged_days)} upisana dana i ${String(c.needs_weigh_ins)} vaganja u zadnjih 7 dana. Ovaj tjedan: ${String(c.logged_days)} upisana dana i ${String(c.weigh_ins)} vaganja.`,
+    ],
+    not_trusted: [
+      en
+        ? `Your TDEE is about ${tdee} kcal. A step waits until calibration trusts it (± 200 kcal at most): about ${f.day(c.expected ?? ap.next)}, if you keep logging and weighing in as now.`
+        : `TDEE je oko ${tdee} kcal. Korak čeka da mu kalibracija vjeruje (najviše ± 200 kcal): oko ${f.day(c.expected ?? ap.next)}, ako nastaviš upisivati i vagati se kao sada.`,
+    ],
+    first_wait: [
+      en
+        ? `A phase’s first 14 days move water and glycogen as much as fat. The first step can come from ${f.day(c.from ?? ap.next)}.`
+        : `Prvih 14 dana faze miče vodu i glikogen koliko i mast. Prvi korak može doći od ${f.day(c.from ?? ap.next)}.`,
+    ],
+    pending: [
+      en
+        ? 'A proposal waits for your answer. The review waits too, so two changes don’t meet in your plan.'
+        : 'Prijedlog čeka tvoj odgovor. Pregled čeka s njim, da se dvije promjene ne sretnu u planu.',
+    ],
+    few_carbs: [
+      pace,
+      en
+        ? `Rest days have ${f.n(c.carbs_g ?? 0)} g carbs. A step down takes 25 g, and protein and fat are never the autopilot’s to change. Ask your coach to change the split.`
+        : `Dani odmora imaju ${f.n(c.carbs_g ?? 0)} g UH. Korak dolje uzima 25 g, a proteini i masti nikad nisu autopilotovi. Zamoli trenera da promijeni raspodjelu.`,
+    ],
+    no_plan: [
+      en
+        ? 'The autopilot needs a phase and a kcal target to judge your pace against.'
+        : 'Autopilotu trebaju faza i cilj kcal prema kojima ocjenjuje tempo.',
+    ],
+    underweight: [
+      en
+        ? `Your BMI is ${f.n(c.bmi ?? 0, 1)}, under 18.5. The autopilot never takes a loss further there, so it proposes maintenance at your TDEE, ${tdee} kcal.`
+        : `BMI ti je ${f.n(c.bmi ?? 0, 1)}, ispod 18,5. Tu autopilot nikad ne nastavlja gubitak, pa predlaže održavanje na TDEE-u, ${tdee} kcal.`,
+    ],
+  }
+  why = reasons[c.reason] ?? []
+  if (c.outcome === 'applied' || (c.outcome === 'proposed' && c.reason !== 'underweight')) {
+    why = [
+      ...why,
+      en
+        ? `Both types of day ${down ? 'lose' : 'gain'} ${k(step)} kcal, all of it carbs (${down ? '−' : '+'}${carbs} g): ${k(c.target_kcal)} → ${newAvg} kcal a day on average.`
+        : `Oba tipa dana ${down ? 'gube' : 'dobivaju'} ${k(step)} kcal, sve iz ugljikohidrata (${down ? '−' : '+'}${carbs} g): prosjek ${k(c.target_kcal)} → ${newAvg} kcal dnevno.`,
+    ]
+  }
+
+  const header = en
+    ? `Autopilot · weekly review, ${f.long(c.date)}`
+    : `Autopilot · tjedni pregled, ${f.long(c.date)}`
+  const driftLine =
+    ap.mode === 'autopilot' && c.reason !== 'no_plan'
+      ? en
+        ? `Drift: ${f.signed(c.outcome === 'applied' ? ap.drift.used_kcal : ap.drift.used_kcal)} of ${k(ap.drift.limit_kcal)} kcal.`
+        : `Odstupanje: ${f.signed(ap.drift.used_kcal)} od ${k(ap.drift.limit_kcal)} kcal.`
+      : undefined
+  const tail =
+    c.outcome === 'applied'
+      ? en
+        ? `Next review ${next}. Take it back in the plan: /plan`
+        : `Sljedeći pregled ${next}. Vrati u planu: /plan`
+      : c.outcome === 'proposed'
+        ? en
+          ? `Accept or reject in the plan by ${f.day(addWeek(c.date))}: /plan`
+          : `Prihvati ili odbij u planu do ${f.day(addWeek(c.date))}: /plan`
+        : en
+          ? `Next review ${next}.`
+          : `Sljedeći pregled ${next}.`
+  const telegram = [
+    header,
+    `${headline}.`,
+    ...why,
+    ...(c.past_drift
+      ? [
+          en
+            ? `It would apply this by itself, but that takes the drift to ${f.signed(driftAfter)} kcal, past your limit of ${k(ap.drift.limit_kcal)}.`
+            : `Ovo bi primijenio sam, ali odstupanje bi bilo ${f.signed(driftAfter)} kcal, preko tvoje granice od ${k(ap.drift.limit_kcal)}.`,
+        ]
+      : []),
+    ...(driftLine === undefined ? [] : [driftLine]),
+    tail,
+  ].join('\n')
+
+  return { headline, why, line, push: { title, body }, telegram, morning }
+}
+
+function addWeek(date: string): string {
+  const d = new Date(`${date}T00:00:00Z`)
+  d.setUTCDate(d.getUTCDate() + 7)
+  return d.toISOString().slice(0, 10)
+}
+
+// pastDrift says, on a proposal the autopilot made past its limit, why it
+// asks: what it would have applied, and what an answer does.
+export function pastDrift(lang: Lang, c: CheckIn, ap: Autopilot): string {
+  const f = fmt(lang)
+  const after = ap.drift.used_kcal + (c.step_kcal ?? 0)
+  return lang === 'en'
+    ? `On autopilot this step would apply by itself, but it would take the drift to ${f.signed(after)} kcal, past your limit of ${f.n(ap.drift.limit_kcal)} (${String(ap.drift.limit_pct)} % of your TDEE). Accepting it makes it a target you agreed to: the drift starts again at 0.`
+    : `Na autopilotu bi se ovaj korak primijenio sam, ali odstupanje bi bilo ${f.signed(after)} kcal, preko tvoje granice od ${f.n(ap.drift.limit_kcal)} (${String(ap.drift.limit_pct)} % TDEE-a). Prihvaćen postaje dogovoreni cilj: odstupanje kreće od 0.`
+}
+
+// days is "3 days" in the language, for a hint.
+export function daysWord(lang: Lang, n: number): string {
+  return lang === 'en'
+    ? `${String(n)} ${plural('en', n, { one: 'day', other: 'days' })}`
+    : `${String(n)} ${plural('hr', n, { one: 'dan', few: 'dana', other: 'dana' })}`
+}
